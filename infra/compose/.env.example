# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control
#
# Deploying to the dev.marin.cr VPS? The values below are local-development
# defaults. See docs/ssl-nginx-setup.md for the full deployment guide and the
# per-variable table; the ones that must change are:
#
#   COMPOSE_PROJECT_NAME=opifex
#   NGINX_PORT=8328
#   APP_URL=https://opifex.dev.marin.cr
#   CORS_ORIGIN=https://opifex.dev.marin.cr
#   GOOGLE_CALLBACK_URL=https://opifex.dev.marin.cr/api/auth/google/callback
#   POSTGRES_HOST=postgres        # shared container on the devnet network
#   POSTGRES_DB=opifex
#   TEST_AUTH_ENABLED=false       # the host is publicly reachable
#   JWT_SECRET / COOKIE_SECRET    # openssl rand -base64 32 (generate, never reuse)
# =============================================================================

# -----------------------------------------------------------------------------
# Compose
# -----------------------------------------------------------------------------
# Docker Compose derives the project name from the directory holding the compose
# file, which is `compose` for every app using this layout. On a host running
# more than one of them that collision makes `up` treat the other app's
# containers as orphans of this project. Always set it explicitly.
COMPOSE_PROJECT_NAME=opifex

# Host port published by the nginx container. The dev.marin.cr VPS sets 8328,
# opifex's slot in that host's nginx `map $host $backend_port` block.
NGINX_PORT=3535

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3535

# Allowed browser origin. Left empty the API reflects ANY request Origin while
# sending credentials, so pin it to the app's own origin on any deployed host.
CORS_ORIGIN=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# External database connection (DATABASE_URL is constructed from these at runtime)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
POSTGRES_SSL=false

# -----------------------------------------------------------------------------
# JWT / Session
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret for production (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECRET=your-cookie-secret-key-min-32-characters-long

# -----------------------------------------------------------------------------
# OAuth - Google (Required)
# -----------------------------------------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3535/api/auth/google/callback

# -----------------------------------------------------------------------------
# OAuth - Microsoft (Optional)
# -----------------------------------------------------------------------------
# Get credentials from: https://portal.azure.com
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_CALLBACK_URL=http://localhost:3535/api/auth/microsoft/callback

# -----------------------------------------------------------------------------
# Initial Admin Bootstrap
# -----------------------------------------------------------------------------
# First user to log in with this email will be assigned Admin role
INITIAL_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Test Authentication (Development/Test Only)
# -----------------------------------------------------------------------------
# Test auth is automatically enabled when NODE_ENV !== 'production'
# This provides /api/auth/test/login endpoint and /testing/login page
# for Playwright E2E testing without requiring real OAuth credentials.
#
# Set to 'false' to explicitly disable test auth in development:
# TEST_AUTH_ENABLED=false
#
# Set it to 'false' on any non-production host that is reachable from the
# internet. The endpoint bypasses OAuth and the email allowlist and can issue
# an admin session for any address, and a host serving the Vite dev server has
# to run NODE_ENV=development, so NODE_ENV alone will not switch it off.
#
# WARNING: Setting TEST_AUTH_ENABLED=true in production will cause the app
# to fail at startup as a safety measure.

# -----------------------------------------------------------------------------
# Device Authorization Flow (RFC 8628)
# -----------------------------------------------------------------------------
# Configuration for device authorization (CLI, Swagger UI, mobile apps)
DEVICE_CODE_EXPIRY_MINUTES=15
DEVICE_CODE_POLL_INTERVAL=5
# Lifetime of access and refresh tokens issued by the device flow (default: 7 days)
DEVICE_TOKEN_EXPIRY_DAYS=7

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# Only meaningful when the otel.compose.yml overlay is also running; with no
# collector reachable the SDK retries exports on a loop and floods the logs.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=opifex-api
LOG_LEVEL=info
# OTEL_DEBUG=true  # Uncomment to enable OTEL diagnostic logging (development only)

# -----------------------------------------------------------------------------
# Uptrace (when using docker-compose.otel.yml)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Uptrace credentials
# -----------------------------------------------------------------------------
# These were previously hardcoded in infra/otel/uptrace.yml and
# infra/otel/otel-collector-config.yaml. They are development defaults only —
# CHANGE THEM before exposing the observability stack anywhere non-local.
UPTRACE_PROJECT1_TOKEN=project1_secret_token
UPTRACE_SECRET_KEY=change-me-in-production-1234567890abcdef
UPTRACE_ADMIN_EMAIL=admin@localhost
UPTRACE_ADMIN_PASSWORD=admin
UPTRACE_PGPASSWORD=uptrace
# Where the Uptrace UI is reached. 2.x uses this for dashboard links and CORS.
UPTRACE_SITE_URL=http://localhost:14318
# Optional. Uptrace 2.x requires Redis; the bundled instance needs no auth.
# UPTRACE_REDIS_PASSWORD=
# Optional. The bundled ClickHouse runs with the default user and no password.
# UPTRACE_CH_USER=default
# UPTRACE_CH_PASSWORD=

UPTRACE_DSN=http://project1_secret_token@localhost:14317/1

# -----------------------------------------------------------------------------
# ClickHouse (Uptrace storage - typically no changes needed)
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Storage provider (currently only 's3' is supported)
STORAGE_PROVIDER=s3

# S3 Storage Settings
# For AWS S3: Set region and credentials, leave S3_ENDPOINT empty
# For MinIO/LocalStack: Set S3_ENDPOINT to your local service URL
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000  # Optional: for MinIO/LocalStack

# Storage Limits and Configuration
# 10GB in bytes. Note the simple-upload endpoint is separately capped at 100MB
# by the @fastify/multipart limit in apps/api/src/main.ts; larger files must go
# through the resumable pre-signed flow.
MAX_FILE_SIZE=10737418240
ALLOWED_MIME_TYPES=image/*,application/pdf,video/*
# Signed URL expiration in seconds (1 hour)
SIGNED_URL_EXPIRY=3600
# Multipart upload part size in bytes (10MB)
STORAGE_PART_SIZE=10485760

# =============================================================================
# GitHub (epic #15)
# =============================================================================
# A FINE-GRAINED personal access token, not a classic one and not a GitHub App
# — see docs/adr/0001-github-authentication.md for why. Grant it only the
# repositories Opifex watches, with Issues (read/write), Pull requests (read),
# Contents (read) and Metadata (read).
#
# Leave it unset and the API still boots; every GitHub call then fails with a
# clear auth error rather than the container refusing to start.
GITHUB_TOKEN=
# Override for GitHub Enterprise Server.
GITHUB_API_BASE_URL=https://api.github.com
# GitHub rejects requests that send no User-Agent.
GITHUB_USER_AGENT=opifex
GITHUB_REQUEST_TIMEOUT_MS=15000
# Retries apply to transient failures only (5xx, timeouts). Rate-limit
# exhaustion is surfaced with its reset time, never retried into.
GITHUB_MAX_RETRIES=3
# Requests held back from the reconciler so interactive use keeps working —
# VISION §11 notes automated runs compete with a human for one 5000/hour
# budget. Raise it if you hit the API from a shell while Opifex is running.
GITHUB_RATE_LIMIT_RESERVE=100
# Bounds the in-memory conditional-request (ETag) cache. Roughly: watched
# repositories x pollable resources x pages.
GITHUB_ETAG_CACHE_MAX=2000
