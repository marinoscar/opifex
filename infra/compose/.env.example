# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control
#
# Deploying to the dev.marin.cr VPS? The values below are local-development
# defaults. See docs/ssl-nginx-setup.md for the full deployment guide and the
# per-variable table; the ones that must change are:
#
#   COMPOSE_PROJECT_NAME=opifex
#   NGINX_PORT=8328
#   APP_URL=https://opifex.dev.marin.cr
#   CORS_ORIGIN=https://opifex.dev.marin.cr
#   GOOGLE_CALLBACK_URL=https://opifex.dev.marin.cr/api/auth/google/callback
#   POSTGRES_HOST=postgres        # shared container on the devnet network
#   POSTGRES_DB=opifex
#   TEST_AUTH_ENABLED=false       # the host is publicly reachable
#   JWT_SECRET / COOKIE_SECRET    # openssl rand -base64 32 (generate, never reuse)
#                                 JWT_SECRET is REQUIRED: the API refuses to
#                                 boot without one of at least 32 chars (#278)
# =============================================================================

# -----------------------------------------------------------------------------
# Compose
# -----------------------------------------------------------------------------
# Docker Compose derives the project name from the directory holding the compose
# file, which is `compose` for every app using this layout. On a host running
# more than one of them that collision makes `up` treat the other app's
# containers as orphans of this project. Always set it explicitly.
COMPOSE_PROJECT_NAME=opifex

# Host port published by the nginx container. The dev.marin.cr VPS sets 8328,
# opifex's slot in that host's nginx `map $host $backend_port` block.
NGINX_PORT=3535

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3535

# Allowed browser origin. Left empty the API reflects ANY request Origin while
# sending credentials, so pin it to the app's own origin on any deployed host.
CORS_ORIGIN=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# External database connection (DATABASE_URL is constructed from these at runtime)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# THIS VALUE IS REJECTED WHEN NODE_ENV=production (#299).
#
# The API refuses to start on a production deployment whose POSTGRES_PASSWORD
# is unset, empty, or still the `postgres` below — see
# apps/api/src/config/env.validation.ts. Copying this file is not choosing a
# password, and the check exists precisely because `cp .env.example .env` is
# the documented setup step.
#
# Outside production the default stays, deliberately: a laptop checkout and
# `docker compose up` should not need a decision here. Change it on anything
# you deploy.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
POSTGRES_SSL=false

# -----------------------------------------------------------------------------
# JWT / Session
# -----------------------------------------------------------------------------
# JWT_SECRET IS MANDATORY AND ENFORCED AT BOOT (#278).
#
# The API refuses to start if it is unset or shorter than 32 characters — see
# apps/api/src/config/env.validation.ts, which explains why this one variable
# is a hard startup failure when a missing database or missing Google
# credentials deliberately are not. A deployment that has never set it will now
# fail loudly on the next restart instead of booting into a state where every
# access token was verified against a string published in this repository.
#
# Generate one, never reuse one, and change the placeholder below:
#   openssl rand -base64 32     # 44 characters, comfortably over the floor
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# Optional. Unset means cookies are signed with JWT_SECRET; set it and it must
# clear the same 32-character floor, or the API refuses to start.
COOKIE_SECRET=your-cookie-secret-key-min-32-characters-long

# -----------------------------------------------------------------------------
# OAuth - Google (Required)
# -----------------------------------------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3535/api/auth/google/callback

# -----------------------------------------------------------------------------
# OAuth - Microsoft (Optional)
# -----------------------------------------------------------------------------
# Get credentials from: https://portal.azure.com
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_CALLBACK_URL=http://localhost:3535/api/auth/microsoft/callback

# -----------------------------------------------------------------------------
# Initial Admin Bootstrap
# -----------------------------------------------------------------------------
# First user to log in with this email will be assigned Admin role
INITIAL_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Test Authentication (Development/Test Only)
# -----------------------------------------------------------------------------
# Test auth is automatically enabled when NODE_ENV !== 'production'
# This provides /api/auth/test/login endpoint and /testing/login page
# for Playwright E2E testing without requiring real OAuth credentials.
#
# Set to 'false' to explicitly disable test auth in development:
# TEST_AUTH_ENABLED=false
#
# Set it to 'false' on any non-production host that is reachable from the
# internet. The endpoint bypasses OAuth and the email allowlist and can issue
# an admin session for any address, and a host serving the Vite dev server has
# to run NODE_ENV=development, so NODE_ENV alone will not switch it off.
#
# WARNING: Setting TEST_AUTH_ENABLED=true in production will cause the app
# to fail at startup as a safety measure.

# -----------------------------------------------------------------------------
# Device Authorization Flow (RFC 8628)
# -----------------------------------------------------------------------------
# Configuration for device authorization (CLI, Swagger UI, mobile apps)
DEVICE_CODE_EXPIRY_MINUTES=15
DEVICE_CODE_POLL_INTERVAL=5
# Lifetime of access and refresh tokens issued by the device flow (default: 7 days)
DEVICE_TOKEN_EXPIRY_DAYS=7

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# Only meaningful when the otel.compose.yml overlay is also running; with no
# collector reachable the SDK retries exports on a loop and floods the logs.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=opifex-api
LOG_LEVEL=info
# OTEL_DEBUG=true  # Uncomment to enable OTEL diagnostic logging (development only)

# -----------------------------------------------------------------------------
# Uptrace (when using docker-compose.otel.yml)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Uptrace credentials
# -----------------------------------------------------------------------------
# These were previously hardcoded in infra/otel/uptrace.yml and
# infra/otel/otel-collector-config.yaml. They are development defaults only —
# CHANGE THEM before exposing the observability stack anywhere non-local.
UPTRACE_PROJECT1_TOKEN=project1_secret_token
UPTRACE_SECRET_KEY=change-me-in-production-1234567890abcdef
UPTRACE_ADMIN_EMAIL=admin@localhost
UPTRACE_ADMIN_PASSWORD=admin
UPTRACE_PGPASSWORD=uptrace
# Where the Uptrace UI is reached. 2.x uses this for dashboard links and CORS.
UPTRACE_SITE_URL=http://localhost:14318
# Optional. Uptrace 2.x requires Redis; the bundled instance needs no auth.
# UPTRACE_REDIS_PASSWORD=
# Optional. The bundled ClickHouse runs with the default user and no password.
# UPTRACE_CH_USER=default
# UPTRACE_CH_PASSWORD=

UPTRACE_DSN=http://project1_secret_token@localhost:14317/1

# -----------------------------------------------------------------------------
# ClickHouse (Uptrace storage - typically no changes needed)
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Storage provider (currently only 's3' is supported)
STORAGE_PROVIDER=s3

# S3 Storage Settings
# For AWS S3: Set region and credentials, leave S3_ENDPOINT empty
# For MinIO/LocalStack: Set S3_ENDPOINT to your local service URL
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000  # Optional: for MinIO/LocalStack

# Storage Limits and Configuration
# 10GB in bytes. Note the simple-upload endpoint is separately capped at 100MB
# by the @fastify/multipart limit in apps/api/src/main.ts; larger files must go
# through the resumable pre-signed flow.
MAX_FILE_SIZE=10737418240
ALLOWED_MIME_TYPES=image/*,application/pdf,video/*
# Signed URL expiration in seconds (1 hour)
SIGNED_URL_EXPIRY=3600
# Multipart upload part size in bytes (10MB)
STORAGE_PART_SIZE=10485760

# =============================================================================
# Secrets at rest (#337, epic #332)
# =============================================================================
# The AES-256 data key that encrypts operator-supplied credentials stored in
# the database — the GitHub token, the Claude credential, and everything else
# epic #332 moves out of this file and into the Control Center UI.
#
# Generate one, per deployment, and never reuse another deployment's:
#   openssl rand -base64 32     # 32 random bytes, which is exactly the size
#                               # required; a value that decodes to any other
#                               # length is rejected.
#
# LOSING THIS KEY IS UNRECOVERABLE. It is not a password that can be reset and
# it is not derived from anything else: every stored secret is encrypted under
# it and no copy of the plaintext is kept anywhere. Lose it — a wiped host, an
# unbacked-up .env, a container recreated without it — and every credential in
# the database is permanently unreadable, and the only way forward is to issue
# NEW credentials at each provider and store them again. Back it up wherever
# you keep JWT_SECRET, and keep it OUT of the database it protects.
#
# Leaving it unset does not stop the API booting, deliberately, the same way a
# missing GITHUB_TOKEN or missing Google credentials do not (see
# apps/api/src/config/env.validation.ts for why JWT_SECRET is different).
# Without it: everything unrelated to secrets works normally, reads fall back
# to the environment variables below, and any attempt to STORE a secret is
# answered with a 503 naming this variable.
#
# Changing it is a rotation, and rotation tooling does not exist yet: today a
# changed key means every stored secret fails to open and is reported as an
# error — never silently replaced by the environment value, which would
# resurrect a credential you had already rotated away from.
OPIFEX_SETTINGS_ENCRYPTION_KEY=

# =============================================================================
# GitHub (epic #15)
# =============================================================================
# NOW MANAGED IN THE CONTROL CENTER (#348, `/admin/settings` → Configuration).
# Every variable in this block is a registry key in
# apps/api/src/settings/operator-settings/operator-settings.registry.ts: an
# Admin can change it there and it takes effect without a restart or an edit
# to this file (see docs/operator-configuration.md for the resolution order
# and per-key reload semantics). What is below is the FLOOR — the value used
# when no database override exists, and what a deployment falls back to if
# the operator-settings overlay itself is unavailable. It is not dead
# configuration: it is still read, still validated, and still the value a
# fresh install runs on before anyone has opened the Control Center.
#
# A FINE-GRAINED personal access token, not a classic one and not a GitHub App
# — see docs/adr/0001-github-authentication.md for why. Grant it only the
# repositories Opifex watches, with Issues (read/write), Pull requests (read),
# Contents (read) and Metadata (read).
#
# Leave it unset and the API still boots; every GitHub call then fails with a
# clear auth error rather than the container refusing to start.
GITHUB_TOKEN=
# Override for GitHub Enterprise Server.
#
# THE API REFUSES TO START if this is set to something that is not a URL
# (#441). It is the only setting that does. Every other unreadable value falls
# back and logs; this one decides WHERE GITHUB_TOKEN IS SENT, and the value it
# would fall back to — the public https://api.github.com below — is a
# different host from the one an Enterprise operator just named. There is no
# safe substitute to choose on their behalf, so the boot fails naming the
# variable rather than putting their token somewhere they did not ask for.
# Include the scheme: `github.corp.example` is refused, `https://github.corp.example/api/v3` is not.
GITHUB_API_BASE_URL=https://api.github.com
# GitHub rejects requests that send no User-Agent.
GITHUB_USER_AGENT=opifex
GITHUB_REQUEST_TIMEOUT_MS=15000
# Retries apply to transient failures only (5xx, timeouts). Rate-limit
# exhaustion is surfaced with its reset time, never retried into.
GITHUB_MAX_RETRIES=3
# Requests held back from the reconciler so interactive use keeps working —
# VISION §11 notes automated runs compete with a human for one 5000/hour
# budget. Raise it if you hit the API from a shell while Opifex is running.
GITHUB_RATE_LIMIT_RESERVE=100
# Bounds the in-memory conditional-request (ETag) cache. Roughly: watched
# repositories x pollable resources x pages.
GITHUB_ETAG_CACHE_MAX=2000
# The global write kill switch. DEFAULTS ON as of ADR-0019 (#439), and the
# reversal is deliberate: VISION §12's observation week is now something you
# turn writes OFF for, rather than something you get by never turning them on.
# The evidence that decided it is #432 — a release path that never removed
# factory:hold went undetected for exactly as long as nothing was permitted to
# act, so the default hid a bug rather than protecting anyone from one.
#
# This value is the FLOOR: unset, the default (true) applies; a database row
# written from the Control Center outranks whatever is here.
#
# With it off, every write adapter returns a complete result with
# performed=false and issues no HTTP request — so the calling path exercised
# during an observation week is the real one.
#
# EVERY boolean in this file accepts true/false, 1/0, yes/no or on/off, in any
# case, with surrounding spaces ignored (#439). Anything else is not a boolean:
# the declared default applies and the API logs an ERROR naming the variable,
# the value it could not read, and the value in force. That widening exists
# because the fallback direction reversed with these defaults — a value that
# could not be read used to leave writes off and now leaves them on, so a
# plausible spelling of "no" had to stop being discarded.
#
# Note what this does NOT switch on by itself: no repository is written to
# until that repository's own mirrorLabelsEnabled / specFeedbackEnabled flags
# are turned on, and those still default off per repository.
# Commented out so this file stays a FLOOR rather than a pin: an uncommented
# value in a copied .env freezes today's default and stops that install
# following a later change. Uncomment to differ from the shipped posture.
# GITHUB_WRITES_ENABLED=true

# =============================================================================
# Reconciler (epic #16)
# =============================================================================
# NOW MANAGED IN THE CONTROL CENTER (#348, `/admin/settings` → Configuration).
# All three variables below are registry keys; see the GitHub section above
# for what "floor" means here and docs/operator-configuration.md for the
# resolution order and reload semantics — `RECONCILER_ENABLED` in particular
# is that doc's worked `live`-reload example.
#
# The control loop. DEFAULTS ON as of ADR-0019 (#439), and it is the flag that
# makes the other four mean anything: this gates the WHOLE loop — observation,
# projection, liveness, the watchdog, escalations, notification delivery, spec
# feedback and the dispatch drain — so a deployment with it off does nothing at
# all, however much else is enabled. Off, "why is nothing running" has an
# answer that no other setting reveals.
#
# The old default's reason was that the tick reads GitHub on a schedule, so an
# install pointed at no repository would start polling. It costs nothing: with
# no watched repository there is nothing to poll, and with ETags an unchanged
# one costs no rate-limit budget either.
#
# It is READ-ONLY by construction: the reconciler module imports the GitHub
# READ module and not the write module, so enabling this cannot cause a write.
# Mirror-label writing is a separate flag, per repository.
#
# Left COMMENTED OUT deliberately, like the four other posture switches in this
# file: an uncommented value in a copied .env pins today's default forever and
# stops that install following a later change. Uncomment only to differ from
# the shipped posture.
# RECONCILER_ENABLED=true
# How often the tick runs. VISION §13: start with polling, add webhooks only
# when tick latency demonstrably hurts. One minute is prompt enough that a
# human editing a label sees an effect quickly, and with ETags an unchanged
# repository costs no rate-limit budget at all.
RECONCILER_INTERVAL_MS=60000
# How long tick records are kept. Every tick writes a row — a log with gaps
# cannot be reviewed, since a missing entry is indistinguishable from a tick
# that never ran — but the heavy projection/action payload is stored only for
# ticks that computed something or failed, so a quiet tick costs a few hundred
# bytes. Deliberately longer than VISION §12's one-week observation window, so
# the week is still fully reviewable on the day it ends.
RECONCILER_LOG_RETENTION_DAYS=14

# =============================================================================
# Notifications (epic #17, issue #58)
# =============================================================================
# NOTIFY_RECEIPT_TIMEOUT_MS and NOTIFY_FALLBACK_WEBHOOK_URL below are NOW
# MANAGED IN THE CONTROL CENTER (#348, `/admin/settings` → Configuration) —
# see the GitHub section above for what that means and
# docs/operator-configuration.md for the resolution order. VAPID_PUBLIC_KEY,
# VAPID_PRIVATE_KEY and VAPID_SUBJECT are NOT migrated and stay env-only: the
# registry's header explains why (rotating a VAPID key pair invalidates every
# existing device subscription, which is a migration, not a setting).
#
# The last link in the chain VISION §1 complains about. The watchdog can notice
# a stall in ninety seconds and detection latency is still measured in hours if
# nobody is actually told.
#
# Web Push (RFC 8030) with VAPID (RFC 8292). No third-party account and no
# per-vendor credential — generate the key pair once:
#
#     npx web-push generate-vapid-keys
#
# Chosen over ntfy and Pushover because the payload is encrypted end to end, so
# the push service relays bytes it cannot read. That is what makes it
# acceptable to put the escalation's real reason in the notification body
# rather than a "something happened, open the app" stub — and a stub fails
# VISION §8's "enough context to decide" outright. See
# docs/adr/0004-notification-transport.md.
#
# UNSET DISABLES THE TRANSPORT, visibly: escalations are still recorded, and
# each one is marked `failed` with a reason naming these variables. An
# unconfigured install shows up in the cockpit instead of looking like a system
# that has never had anything to say.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The mailto: a push service contacts if our requests misbehave. Part of the
# VAPID spec, not optional decoration.
VAPID_SUBJECT=mailto:ops@example.com

# How long a dispatched escalation may go without a device receipt before it is
# treated as undelivered.
#
# Web Push gives NO delivery guarantee: a 201 means the push service accepted
# custody, not that a phone showed anything. The service worker posts a receipt
# back and this is how long we wait for it. An escalation still unconfirmed
# after this is recorded `failed` — because #58 is explicit that one which
# silently failed to send is indistinguishable from no escalation while looking
# handled on a dashboard.
NOTIFY_RECEIPT_TIMEOUT_MS=120000

# A SECOND, INDEPENDENT path, used only when Web Push did not deliver.
#
# #58: "a delivery failure must itself escalate through a different path." A
# retry of the same transport is not a different path — if the push service is
# down or no device is subscribed, trying again produces the same silence.
#
# A generic JSON POST, so it works with ntfy, a chat webhook, or anything that
# accepts JSON. OFF unless set, deliberately: it sends escalation text to a
# third party, which is your decision and not a default. With it unset, a Web
# Push failure ends at a `failed` escalation, an error log marked
# NOTIFICATION FAILED, and the cockpit's failed list.
NOTIFY_FALLBACK_WEBHOOK_URL=

# =============================================================================
# Dispatch (epic #18, issue #64)
# =============================================================================
# DISPATCH_MAX_CONCURRENT, DISPATCH_ALLOW_PREVIEW_RUNNER, DISPATCH_RETRY_CEILING
# and DISPATCH_ENABLED are NOW MANAGED IN THE CONTROL CENTER (#348,
# `/admin/settings` → Configuration) — see the GitHub section above for what
# that means. DISPATCH_ENABLED in particular is the switch you actually want
# to flip live once things are running; see docs/operator-configuration.md.
#
# The hard spend ceiling below (OPIFEX_HARD_SPEND_CEILING_USD and its window)
# is managed too, as of #345 — but it is the one key here whose editability was
# argued for on the record rather than assumed. See that subsection.
#
# A ceiling on live runs across the WHOLE fleet, on top of each runner's own
# maxConcurrency in its capability manifest.
#
# VISION §11 designs for a single operator sharing one GitHub budget and one
# machine with the automated runs. This is how that operator caps total spend
# and load without editing every runner's manifest.
#
# Unset means no global ceiling — each runner's own limit still applies. A run
# that cannot be placed QUEUES with a recorded reason rather than failing, so
# setting this too low costs throughput and nothing else.
#
# The other way to say "no global ceiling" is the word `unlimited` (`null`
# still works, and is what a Control Center field cleared to empty stores).
# Those two words and an UNSET variable are the only three routes to it: a
# value in range is used, and a value OUT of range — `200`, say, which is a
# plausible thing to type and used to resolve to no ceiling at all — falls
# back to the maximum, 128, and is logged at ERROR naming the value in force.
# A typo must never be able to remove a ceiling (#441).
DISPATCH_MAX_CONCURRENT=

# Lets a PREVIEW-tier runner be load-bearing when no GA fallback exists.
#
# See docs/adr/0007-preview-runner-acknowledgement.md. Two VISION rules meet
# here: §11 wants every preview runner backed by a GA one, and §3.7 forbids
# building a second runner before it is needed. With exactly one runner the
# fallback cannot exist, so leaving this off means the only runner is
# permanently ineligible and every work order queues forever.
#
# Setting this to 'true' is you accepting that a runner declaring itself
# experimental is the one doing your work. It does NOT change the runner's own
# stability tier, and it does not override anything else — unmet capabilities,
# concurrency ceilings and the fleet limit all still apply. The decision
# records that the acknowledgement was used, so it stays answerable later.
#
# DEFAULTS ON as of ADR-0019 (#439) — the clearest of the four flips. With one
# runner the GA fallback cannot exist, so this rule could not be satisfied by
# ANY shipped configuration; off, it was not a safety rule but a permanent off
# switch that queued every work order forever. The rule stays in the code and
# regains its force the moment a second, GA runner exists. Turn it back off
# then. This value is the floor; a Control Center row outranks it.
# Commented out: this file is the floor, not a pin. Uncomment to differ.
# DISPATCH_ALLOW_PREVIEW_RUNNER=true

# How many attempts a work order gets before it is quarantined (issue #66).
#
# Abandon-and-re-run (VISION §3.4) needs a stopping condition. Without one a
# work order that cannot succeed re-dispatches forever, burning the quota that
# working runs need — and the only alternative, silent abandonment, is worse:
# nobody is told. At the ceiling the work order is QUARANTINED instead, which is
# visible and which by VISION §8 only a human can clear.
#
# A rate-limit park does not spend an attempt. A parked run did not fail.
#
# Three is deliberately low. This is also success metric 4 ("attempts per work
# order"), which VISION §10 reads as evidence of how well work was decomposed —
# a generous ceiling hides exactly that signal.
DISPATCH_RETRY_CEILING=3

# Whether the executor ACTS on a dispatch decision, or only records it.
#
# DEFAULTS ON as of ADR-0019 (#439). It is no longer the switch that stands
# between a fresh install and spending money — OPIFEX_HARD_SPEND_CEILING_USD
# below is, and it is aimed at the hazard itself rather than at a proxy for it.
# Leave that unset and this being on costs you nothing: every work order is
# refused with 'no hard spend ceiling is configured' before anything else is
# considered. This value is the floor; a Control Center row outranks it.
#
# With it OFF the executor still runs the whole decision and logs what it WOULD
# have dispatched, to which runner and at which version. That is VISION §12's
# observation-week posture applied to execution rather than to labels, and it
# is still worth doing deliberately — it is just no longer done for you.
# Commented out: this file is the floor, not a pin. Uncomment to differ.
# DISPATCH_ENABLED=true

# -----------------------------------------------------------------------------
# The hard spend ceiling (issue #65)
# -----------------------------------------------------------------------------
# NOT managed in the Control Center, unlike everything else in this file's
# Dispatch and Supervisor sections — this is the one deliberate exception, and
# it stays env-only for now on purpose. ADR-0018 §6
# (docs/adr/0018-operator-settings-resolution-and-ceilings.md) decides this
# ceiling SHOULD become an editable, admin-gated managed key once two other
# pieces of this epic land — but says explicitly that shipping it before both
# are in force would open exactly the hole VISION §8 exists to close. See
# docs/operator-configuration.md's "The hard spend ceilings" section for
# where that migration currently stands.
#
# The most the factory may spend, in US dollars, per rolling window.
#
# REQUIRED, and since ADR-0019 (#439) this is THE gate that stops a fresh
# install spending. The runner, dispatch, the preview-runner acknowledgement
# and GitHub writes all ship ON; this ships unset, and an unset ceiling refuses
# every work order before anything else about it is considered. So a fresh
# install is READY rather than RUNNING: the reconciler observes, the runner
# registers, the queue fills, and nothing dispatches until the line below has a
# number on it.
#
# It is deliberately left empty rather than given a default. A default dollar
# figure would be a guess about somebody else's budget -- that was option D in
# #439 and it was rejected. The number has to be chosen.
#
# With no ceiling set, dispatch refuses rather than proceeding: #65's first
# sentence is that an unsupervised agent with no spend ceiling is the failure
# mode that turns a productivity tool into a bill, and VISION §3.5 gates on
# reversibility -- spend is not reversible, so the unbounded case does not go
# ahead.
#
# Managed in the Control Center as of #345; this value is the floor used when
# no override exists. It was env-only until then, and the change was a
# deliberate reversal rather than a migration -- ADR-0018 §6 is the argument.
#
# VISION §8 still puts the hard ceiling on the NEVER TRUSTABLE list, and its
# clause was amended in the same change rather than quietly contradicted:
# budget configuration is never trustable OUTSIDE an interactive, RBAC-gated
# admin action. Spend above the ceiling still cannot be authorized by any trust
# grant, any promoted action class, or any agent. "A limit an agent can raise
# is not a limit" holds exactly as written; what is admitted is that the
# operator is not an agent.
#
# That is a strictly weaker guarantee than the one it replaced -- from "no
# setter exists" to "a setter exists and the agent cannot reach it" -- and it
# only stands while both barriers hold: the agent subprocess inherits no
# credentials (#334) and settings writes are refused from any credential that
# cannot prove a person was present (#346). If either is ever removed, this
# reverts to env-only with no setter.
#
# A malformed value (a letter O in 50, say) is treated as UNSET and logged as
# an error at boot, never silently as "no ceiling". Zero is a valid setting and
# means spend nothing. This is why the key is declared as a STRING setting
# rather than a number: a numeric schema would reject the typo at the registry
# and report it identically to "nobody set one".
OPIFEX_HARD_SPEND_CEILING_USD=

# The rolling window the ceiling is measured over, in days. Defaults to 30.
#
# A ceiling with no window would be a lifetime cap: reached once, it stops the
# factory permanently and can only be recovered from by raising the limit,
# which turns the safety mechanism into pressure to disable it. A window makes
# the ceiling a rate, which is what an operator means by "at most this much".
OPIFEX_HARD_SPEND_CEILING_WINDOW_DAYS=30

# =============================================================================
# claude-code-local runner (epic #18, issue #61)
# =============================================================================
# Most of this block is NOW MANAGED IN THE CONTROL CENTER (#348,
# `/admin/settings` → Configuration) — see the GitHub section above for what
# that means and docs/operator-configuration.md for the resolution order.
# CLAUDE_CODE_MAX_CONCURRENCY is that doc's worked `next-unit` example.
#
# Two exceptions, both still env-only for now:
#   - CLAUDE_CODE_OAUTH_TOKEN IS a managed key (a secret one), but the Control
#     Center screen that would let you set a secret through the UI —
#     Credentials — is #349 and has not shipped; see that subsection below.
#   - ANTHROPIC_API_KEY is not a managed key at all and stays env-only,
#     structurally, alongside the credentials the registry's own header lists
#     as out of scope for this epic.
#
# The v1 runner: Claude Code, invoked as a CHILD PROCESS on your own hardware.
# See docs/adr/0008-claude-code-local-invocation.md for why a subprocess rather
# than the Agent SDK — the short version is that a supervisor which dies
# alongside the run it was supervising is worse than no supervisor, and that
# cancellation has to be a signal rather than a request.
#
# DEFAULTS ON as of ADR-0019 (#439); off only if set to exactly 'false'. An
# install with no `claude` on its PATH registers the runner as UNAVAILABLE and
# says so at boot, which is a far more useful state than a runner nobody has
# switched on yet — and it still spawns nothing until a hard spend ceiling
# exists. Enabling this and DISPATCH_ENABLED one at a time is still the right
# way to watch the runner register honestly before work is routed to it
# (docs/RUNBOOK-enable-claude-code-local.md); it is now advice rather than a
# wall. This value is the floor; a Control Center row outranks it.
# Commented out: this file is the floor, not a pin. Uncomment to differ.
# CLAUDE_CODE_LOCAL_ENABLED=true

# The CLI to invoke. Resolved on PATH by default; name it explicitly to pin a
# version rather than inheriting whatever the shell finds.
CLAUDE_CODE_BINARY=claude

# -----------------------------------------------------------------------------
# Credentials for the CLI (#326)
# -----------------------------------------------------------------------------
# CLAUDE_CODE_OAUTH_TOKEN is a registered secret key
# (runners.claudeCodeLocal.oauthToken) and is stored encrypted if you set it
# through the operator-settings API — but the Control Center's own Credentials
# section, where that would normally happen from a form, is #349 and is not
# built yet (it shows as "planned" at `/admin/settings` → Credentials today).
# So for now this is still a plain `.env` edit, the same as before this epic.
# ANTHROPIC_API_KEY is not a managed key at all and is env-only permanently.
#
# BOTH ARE UNSET, AND ONE IS REQUIRED. A container cannot complete an
# interactive `claude auth login`, so the credential has to arrive through the
# environment or the runner cannot work at all.
#
# It reaches the agent with no further wiring on your side: base.compose.yml
# loads the whole of this file with `env_file` rather than an enumerated
# `environment:` list. Do NOT add these to an `environment:` block —
# enumerating is the bug that comment records having already been fixed once.
#
# Note that the agent subprocess does NOT inherit the API's environment
# wholesale (#334): it gets an explicit allowlist, and BOTH of the names below
# are on it. A THIRD credential variable added here would not reach the CLI
# until it is added to `apps/api/src/runners/process/child-environment.ts`,
# which is the point of the mechanism — every other secret in this file is
# absent from the agent's environment for the same reason.
#
# This is the failure mode worth understanding before choosing. `claude
# --version` succeeds WITHOUT credentials, and that is the probe the runner
# uses to decide it is available. So an unauthenticated CLI registers as a
# healthy runner, dispatch routes to it, and every run fails at auth. A missing
# binary is the honest failure; a present-but-unauthenticated one is the
# deceptive one.
#
# Pick exactly one:
#
#   CLAUDE_CODE_OAUTH_TOKEN — a subscription token, from `claude setup-token`
#   (requires a Claude subscription). No per-token billing. The cost is that
#   automated runs then draw on THE SAME QUOTA as your own interactive use,
#   which is exactly VISION §11: "automated runs compete with a human for one
#   subscription quota." CLAUDE_CODE_MAX_CONCURRENCY below is the knob that
#   leaves you room to work.
#
#   ANTHROPIC_API_KEY — per-token billing, no quota contention with your own
#   session. It lands on the hard spend ceiling (#65) instead — and note the
#   runner's own manifest already concedes that a dollar ceiling can only be
#   applied to the NEXT attempt, because the CLI reports cost once at the end.
#   The ceiling is coarser than it looks.
#
# Neither is defaulted, deliberately. Which quota an autonomous agent spends is
# an operator's decision, not something to inherit from an example file.
#CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=

# How many runs this runner takes at once.
#
# VISION §11: automated runs compete with YOUR interactive use for one
# subscription quota. Two leaves a human room to work on the same machine.
# The runner refuses to exceed this even if dispatch asks it to.
CLAUDE_CODE_MAX_CONCURRENCY=2

# Permission mode for the agent: acceptEdits, auto, bypassPermissions, manual,
# dontAsk or plan.
#
# Defaults to the narrowest mode that can still do work. A mode broad enough
# never to ask is only safe alongside a sandbox that makes never asking safe,
# and sandboxing is #113. Until then a run that needs a permission it does not
# have goes SILENT, and the watchdog (#54) catches it — which is the failure
# this system exists to notice, not a reason to widen this without thinking
# about it.
#
# A value that cannot be read does NOT fall back to this default: it resolves
# to `plan`, which only proposes and changes nothing (#441). `ask`, `readonly`
# and `plan-only` are all plausible things to type when reaching for something
# STRICTER, and all three used to yield a mode that edits files. The rejection
# is logged at ERROR naming the variable and the mode actually in force.
CLAUDE_CODE_PERMISSION_MODE=acceptEdits

# Which model each `tier:` label runs on (#420).
#
# `tier:small`, `tier:standard` and `tier:large` on an issue are a policy
# statement about the work, and these three are what that policy resolves to.
# The CLI takes either an alias (`haiku`, `sonnet`, `opus`) or a full model
# name; full names are the defaults, because a tier exists to bound spend and
# an alias silently repoints to whatever is current.
#
# A work order with NO tier label is invoked with no model flag at all and
# follows the CLI's own default, which is deliberately not the same as
# `tier:standard` — that one pins a model. Leave any of these empty to give
# that tier the CLI's default too.
#
# These are floors, not the last word: a value set from the Control Center's
# Configuration section outranks what is written here (epic #332). A tier this
# build cannot map runs on the default and is reported, never refused.
CLAUDE_CODE_MODEL_SMALL=claude-haiku-4-5
CLAUDE_CODE_MODEL_STANDARD=claude-sonnet-5
CLAUDE_CODE_MODEL_LARGE=claude-opus-5

# Where per-run workspaces live. One directory per work-order identity, each a
# checkout pinned to the work order's base commit.
RUNNER_WORKSPACE_ROOT=/var/tmp/opifex/workspaces

# The factory's own git identity for commits the agent makes. Without one
# `git commit` fails deep inside the agent, where the reason arrives as an
# opaque non-zero exit. Attribution proper lives in the commit trailers (#26),
# which are structured and cannot be mistaken for a person having written it.
RUNNER_COMMITTER_NAME=Opifex Factory
RUNNER_COMMITTER_EMAIL=factory@opifex.local

# A wall-clock ceiling for work orders that name none of their own, in minutes.
#
# The one limit this runner can actually enforce, because time is observable
# from outside the process. A dollar budget is NOT enforceable mid-run: the CLI
# reports cost once, on its final line, and the per-message usage on assistant
# lines is a streaming snapshot that does not sum to the total. Cost is
# reported accurately on the terminal event, so a budget can gate the NEXT
# attempt (#65/#66) — it cannot stop a run already in flight.
#
# Set to empty for genuinely unbounded runs. That is a deliberate choice, not a
# default: VISION §1's origin story is four hours dead, which is what an
# unbounded run looks like when it wedges.
RUNNER_DEFAULT_TIMEOUT_MINUTES=60

# How long past a run's own wall-clock ceiling before the CONTROL PLANE cancels
# it (issue #180). Defaults to 2 minutes.
#
# A margin rather than zero, so this is a backstop and not a race: the runner
# enforces its own deadline first, and firing at the same instant would land a
# cancel while the runner is already killing its process -- two conflicting
# reasons for one stop, in the logs, at the moment somebody is reading them.
# Two minutes comfortably clears RUNNER_KILL_GRACE_MS plus one poll interval,
# so a runner shutting down cleanly always finishes first.
#
# The ceiling itself is the work order's `wallClockTimeoutMinutes`, falling
# back to RUNNER_DEFAULT_TIMEOUT_MINUTES above. There is deliberately no second
# key for that default -- the runner and the control plane must not be able to
# disagree about when a run is late.
RUNNER_DEADLINE_GRACE_MINUTES=2

# How long a cancelled run has to flush before SIGKILL. Long enough for a CLI
# to write its last line and drop a lockfile, short enough that the watchdog's
# decision to kill lands on the tick it was made.
RUNNER_KILL_GRACE_MS=10000

# Where workspaces clone from and push to. Override for GitHub Enterprise.
#
# THE API REFUSES TO START if this is not a URL (#441) — the same rule, for
# the same reason, as GITHUB_API_BASE_URL above: GITHUB_TOKEN is sent to
# whatever host is named here, and the value it would otherwise fall back to
# (public github.com) is a different host from the one you just named.
# Include the scheme.
GIT_REMOTE_BASE_URL=https://github.com

# The git binary. Named for the same reason as the CLI above.
GIT_BINARY=git

# =============================================================================
# Model credentials, one per provider (#422)
# =============================================================================
# A CREDENTIAL belongs to a PROVIDER; a CONSUMER (the supervisor, and the chat
# epic #419 adds) selects a provider. Before #422 there was ONE key paired with
# one provider setting, so an operator holding an Anthropic key and an OpenAI
# key could store only one of them: switching provider meant overwriting, and
# the previous key was gone. These slots are held independently, so switching a
# consumer's provider neither requires re-entering a credential nor destroys
# one.
#
# Both are managed keys (`/admin/settings` → Configuration) — see the GitHub
# section above for what that means — and both are SECRET, so they are still a
# plain `.env` edit today: the Credentials section that would let you rotate
# them from a form is #349 and is not built yet.
#
# NOT the same thing as ANTHROPIC_API_KEY in the runner section above. That one
# authenticates the Claude Code CLI and bills against the runner's quota; this
# one is the separately metered credential ADR-0015 exists to keep apart from
# it, so that a supervisor invocation never competes with a worker.
#
# Unset is a supported state, not a broken one: the API boots exactly as it
# does without it, and every invocation that needs the missing provider records
# its refusal in the decision log where it is visible. Setting a key is what
# starts the spending, which is why neither has a default.
MODEL_ANTHROPIC_API_KEY=
MODEL_OPENAI_API_KEY=

# Where each provider's API lives. LEAVE EMPTY unless you are pointing at a
# proxy or a test double: empty means "the provider's own endpoint".
#
# Per provider rather than shared, for the same reason the key is: the key is
# SENT to whatever host is named here, so a single override across two vendors
# would post one vendor's credential to the other's gateway the moment a
# consumer switched.
#
# Naming a provider's own published host counts as empty, so a deployment that
# copied the old default out of this file still reaches the right vendor after
# a switch. Anything else -- a proxy, a gateway -- is used as given.
MODEL_ANTHROPIC_BASE_URL=
MODEL_OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# SUPERSEDED: SUPERVISOR_MODEL_API_KEY and SUPERVISOR_MODEL_BASE_URL
# -----------------------------------------------------------------------------
# Both were renamed by #422 and both are STILL READ, so an upgrade does not take
# your supervisor offline at the restart that picks up the rename. Two things
# are worth knowing about the compatibility path:
#
#   1. It feeds the DEFAULT provider's slot only (MODEL_ANTHROPIC_*), and only
#      while the new name is unset. One ambiguous variable cannot honestly name
#      a credential for two vendors, and mapping it onto both would post an
#      `sk-ant-` key to OpenAI on the next provider switch -- the exact
#      confusion #422 removes. If you selected a non-default provider AND still
#      set the old name, the API says so by name at boot.
#   2. The API warns once, naming the replacement, whenever it reads one.
#
# A STORED value -- one saved from the Control Center rather than set here --
# is migrated automatically at the next boot, and that migration is a
# decrypt-then-re-encrypt rather than a rename: `common/crypto/secret-box.ts`
# binds every ciphertext to its setting key, so a renamed row would never open
# again. If it cannot be read, the API says so at boot and asks you to re-enter
# it; it never silently leaves an unreadable credential in place.
#
# Rename them and delete these two lines when convenient.
# SUPERVISOR_MODEL_API_KEY=
# SUPERVISOR_MODEL_BASE_URL=

# =============================================================================
# The AI supervisor (VISION §7), observe-only
# =============================================================================
# SUPERVISOR_ENABLED, SUPERVISOR_MODEL_PROVIDER, SUPERVISOR_MODEL_NAME,
# SUPERVISOR_MODEL_TIMEOUT_MS, SUPERVISOR_MODEL_DEFAULT_MAX_TOKENS,
# SUPERVISOR_LOG_SKIPPED_INVOCATIONS and SUPERVISOR_STAND_DOWN_WHEN_BLOCKED are
# NOW MANAGED IN THE CONTROL CENTER (#348, `/admin/settings` → Configuration)
# — see the GitHub section above for what that means. The credential the
# supervisor spends is no longer a supervisor setting at all: it is whichever
# of the MODEL_* keys above belongs to the provider selected below (#422).
#
# SUPERVISOR_HARD_SPEND_CEILING_USD and its window became managed keys in #345
# — see "The hard spend ceiling" note under Dispatch above; the same ADR-0018
# reasoning covers both ceilings identically.
#
# Whether the supervisor runs at all.
#
# DEFAULTS OFF, and this is one of the switches where the default carries an
# argument. Since ADR-0015 the supervisor spends real money on a metered API
# key of its own -- not the subscription the workers use -- and a deployment
# that has not decided to run one must not start spending on it because a
# default said yes.
#
# Turning it on is also not sufficient on its own: without a credential for the
# selected provider (the MODEL_* keys above), every invocation records a
# refusal that says so, in the decision log, where it is visible. A supervisor
# that appears to be running and is not is the failure the log exists to make
# impossible.
SUPERVISOR_ENABLED=false

# Which vendor the supervisor asks: anthropic or openai (#392).
#
# Defaults to anthropic, which is what ADR-0015 shipped and what every
# deployment configured before #392 is pointed at.
#
# Since #422 this SELECTS a credential rather than being paired with one: the
# key and the base URL come from the MODEL_* slot for the provider named here.
# Switching it neither requires re-entering a key nor destroys the one you had
# — but a provider you have never given a key to leaves the supervisor with
# nothing to ask, once an hour, in the decision log.
SUPERVISOR_MODEL_PROVIDER=anthropic

# Which model answers. Sent verbatim as the request's model field and recorded
# verbatim against every invocation, so "runs on a small model" (VISION §7) is
# a claim checkable against the LOG rather than against this file.
#
# A literal model name rather than a tier, on purpose. A tier would only put
# indirection in front of the same string -- and a tier in the log would say
# what was ASKED for, where the name says which model actually answered. That
# argument got stronger with the second vendor, not weaker: a tier would now
# also have to mean something consistent across two catalogues.
#
# Example: claude-haiku-4-5
SUPERVISOR_MODEL_NAME=

# How long one question may take before it is aborted.
#
# Generous next to GITHUB_REQUEST_TIMEOUT_MS because this is a model generating
# tokens, not an API returning a row. There is no retry anywhere in the
# adapter: a call that times out is recorded as a failure and the next
# scheduled tick asks again.
SUPERVISOR_MODEL_TIMEOUT_MS=60000

# The ceiling on an answer when a proposer does not set its own. Both providers
# take a ceiling on every request, so there is no "unlimited" here.
SUPERVISOR_MODEL_DEFAULT_MAX_TOKENS=1024

# Whether a DISABLED supervisor still writes a skipped row each hour.
#
# Off by default. The decision log must have no gaps while the supervisor is
# meant to be running -- a missing entry is indistinguishable from one that
# silently failed -- but a deployment that never configured a supervisor should
# not accumulate a skip row an hour forever.
SUPERVISOR_LOG_SKIPPED_INVOCATIONS=false

# Stand down while any run is parked on a rate limit.
#
# DEFAULTS ON, which makes it the one supervisor switch that does. The reason
# is not the one it used to be: since ADR-0015 the supervisor spends its own
# budget and competes with no worker for quota. What survives is that a parked
# worker is evidence that everything the supervisor exists to advise about has
# stopped moving -- a diagnosis produced now has nothing live to act on it, and
# will say the same thing once runs resume. Set to false only to debug the
# supervisor itself.
SUPERVISOR_STAND_DOWN_WHEN_BLOCKED=true

# The most the supervisor may spend on ITSELF, per rolling window (ADR-0017).
#
# REQUIRED to run a supervisor at all. Unset is not "unlimited" -- it is a
# refusal: every tick records a skipped_budget row and nothing is asked of the
# model. That is deliberate and it is the bug #261 reported: with
# SUPERVISOR_ENABLED=true and a model key set, nothing in the system compared
# supervisor spend to anything, so an hourly cron could spend without limit
# against a real card with no operator-visible ceiling anywhere. A permissive
# default here would be that bug, restated as a default. The API says which
# state it is in at boot, so a deployment that upgrades into this refusal can
# see why in the log rather than inferring it from an empty decision log.
#
# SEPARATE from OPIFEX_HARD_SPEND_CEILING_USD, on purpose, and neither one
# counts the other's spend. Dispatch's ceiling bounds what the factory spends
# on RUNS; this bounds what the supervisor spends diagnosing them. Folding the
# two together would mean the supervisor goes quiet once the workers have
# spent the shared figure -- which is exactly the moment the component whose
# job is explaining unusual spend needs to be running. An operator who wants a
# combined figure adds the two by hand; nothing here produces one.
#
# It cannot be raised at runtime by any endpoint, setting or trust grant --
# only by changing this value and restarting (VISION §8).
#
# Example: 5
SUPERVISOR_HARD_SPEND_CEILING_USD=

# The rolling window that ceiling is measured over, in days.
#
# ONE day by default, where OPIFEX_HARD_SPEND_CEILING_WINDOW_DAYS is thirty,
# and the difference is the cadence rather than an oversight. Runner spend is
# bursty, so a month is what an operator means by "at most this much". The
# supervisor ticks every hour at a near-constant per-tick cost, so a monthly
# window would be slow to CATCH a misconfiguration -- pointing
# SUPERVISOR_MODEL_NAME at a model fifteen times the rate could run for weeks
# before a monthly figure moved -- and slow to RECOVER once tripped, leaving
# the supervisor dark for up to a month. A day catches a regression within
# about twenty-four ticks and recovers on its own as the window rolls.
SUPERVISOR_HARD_SPEND_CEILING_WINDOW_DAYS=1

# SUPERVISOR_LIVE_RUN_CEILING was RETIRED by ADR-0016 and is no longer read.
#
# It stood the supervisor down once that many runs were live. It gated on a
# count that does not determine what an invocation costs -- every proposer runs
# once per tick whatever `runsRunning` is -- so it bounded nothing it claimed
# to. See docs/adr/0016-supervisor-live-run-ceiling.md. Delete the line if a
# real .env still carries it -- the API warns at boot when it is still set,
# rather than ignoring it in silence. The real cap on the supervisor's metered
# spend is SUPERVISOR_HARD_SPEND_CEILING_USD above (#261, ADR-0017); it bounds
# dollars, which is what the retired setting was reached for and never did.

# =============================================================================
# The steering chat's model (#423, epic #419)
# =============================================================================
# CHAT_MODEL_PROVIDER, CHAT_MODEL_NAME, CHAT_MODEL_TIMEOUT_MS and
# CHAT_MODEL_DEFAULT_MAX_TOKENS are MANAGED IN THE CONTROL CENTER (#348,
# `/admin/settings` -> Configuration, section "Chat") — see the GitHub section
# above for what that means: the values here are the floor a fresh install runs
# on and the fallback if the database overlay is unavailable, and an Admin who
# has ever set one of these from the Control Center has overridden this file.
#
# The chat is the SECOND model consumer. It picks its provider and its model
# independently of the supervisor, and the two can sit on different vendors at
# the same time — instruction parsing is small, frequent and latency-sensitive,
# where a supervisory judgement is occasional and wants the stronger model.
#
# It has NO credential of its own, deliberately. The key and the base URL come
# from the MODEL_* slot for whichever provider is named here, exactly as the
# supervisor's do, so holding one key per vendor covers both consumers and
# switching either one re-enters nothing.

# Which vendor the chat asks. anthropic or openai.
CHAT_MODEL_PROVIDER=anthropic

# Which model answers, sent verbatim as the request's model field.
#
# EMPTY IS THE CHAT'S OFF SWITCH, and empty is the default. There is no
# CHAT_ENABLED: with no model named the chat is inert and reports itself
# unconfigured rather than failing at the first instruction, so an upgrade
# never starts a second metered consumer spending because a default said yes.
# A model named here with no key stored for CHAT_MODEL_PROVIDER is also inert,
# and says which of the two is missing.
#
# Example: claude-haiku-4-5
CHAT_MODEL_NAME=

# How long one chat turn may wait for the model before it is abandoned.
#
# Half the supervisor's, because somebody is waiting on this one. The ceiling
# is 55000 rather than the supervisor's 600000, and the number comes from
# infra/nginx/nginx.conf: proxy_read_timeout is 60s in front of /api, so a turn
# allowed past that is answered by the proxy with a 504 that says nothing about
# the model. Staying under it keeps the API's own abort the thing that fires.
CHAT_MODEL_TIMEOUT_MS=30000

# The ceiling on one answer when the caller does not set its own.
#
# Twice the supervisor's, for a different answer shape: a supervisory judgement
# is a paragraph, and a proposed label diff over a twenty-issue backlog is a
# list as long as the backlog. A truncated list of operations reads exactly
# like a complete one.
CHAT_MODEL_DEFAULT_MAX_TOKENS=2048

# =============================================================================
# The promotion ladder (VISION §7 "Earned autonomy", issue #99)
# =============================================================================
# PROMOTION_LADDER_ENABLED is NOW MANAGED IN THE CONTROL CENTER (#348,
# `/admin/settings` → Configuration) — see the GitHub section above for what
# that means.
#
# Whether the ladder promotes and demotes action classes at all.
#
# DEFAULTS OFF. Like DISPATCH_ENABLED, this switch is upstream of things
# running without a human present: the ladder is what decides that a class of
# action has earned a demonstrated record and may be trusted to execute on its
# own. A default that said yes would make the first unattended action an
# accident rather than a decision somebody took.
#
# OFF means PAUSED, not broken, and the difference matters. With it false the
# ladder promotes nothing and demotes nothing, and every trust grant that
# already exists keeps working exactly as it did. #99 requires the ladder be
# pausable "without dismantling the grants" -- a pause that revoked autonomy
# would be a mass revocation, and nobody would ever pause a second time.
#
# Turning it on does nothing on its own either. A class needs 20 human
# decisions at a 90% approval rate before it can be promoted, and those come
# from reviewing supervisor proposals (SUPERVISOR_ENABLED) and answering
# approval gates. On a fresh install every class sits on rung 1 with no
# evidence, which is what "earned" means.
#
# Promotion still grants nothing by itself: it makes a class ELIGIBLE for a
# trust grant, which an operator creates by tapping "Always approve this
# class". Demotion is the direction that is fully automatic -- it suspends any
# active grants for the class, because VISION §7 rung 4 is explicit that
# demotion is "automatic on regression, not a judgment call."
PROMOTION_LADDER_ENABLED=false
