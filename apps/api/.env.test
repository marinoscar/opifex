# =============================================================================
# Test environment — dummy values only. Committed deliberately (see .gitignore
# exception): the Jest setup (test/setup.ts) loads this file so that a fresh
# clone and CI agree on the environment the suite runs under.
#
# Nothing here is a secret. OAuth is mocked in tests per docs/TESTING.md
# ("Mock OAuth in CI — no real Google dependency"); these values exist only so
# strategy constructors accept them. Real credentials live in
# infra/compose/.env, which stays gitignored.
# =============================================================================

NODE_ENV=test

# Present so the OAuth routes are exercised in their CONFIGURED state, which
# is what most of test/auth asserts. Since #138 the API boots without them:
# see src/auth/auth.module.spec.ts and test/auth/oauth-unconfigured.
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3535/api/auth/google/callback

# JWT signing for token unit tests. 48 chars of obvious dummy.
JWT_SECRET=test-jwt-secret-test-jwt-secret-test-jwt-secret-
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# Deliberately NO POSTGRES_* variables here: configuration.ts supplies
# defaults for all of them, Prisma is mocked in these suites
# (test/mocks/prisma.mock.ts) so nothing ever connects, and a PASSWORD= line
# in a committed file trips secret scanners even when the value is a dummy.

APP_URL=http://localhost:3535
OTEL_ENABLED=false
