{
  "name": "api",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "jest --config ./test/jest.config.js --testPathIgnorePatterns='e2e'",
    "test:all": "jest --config ./test/jest.config.js",
    "test:watch": "jest --config ./test/jest.config.js --watch --testPathIgnorePatterns='e2e'",
    "test:cov": "jest --config ./test/jest.config.js --coverage --testPathIgnorePatterns='e2e'",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand --config ./test/jest.config.js --testPathIgnorePatterns='e2e'",
    "test:e2e": "jest --config ./test/jest.config.js --testRegex '.e2e.spec.ts$'",
    "test:unit": "jest --config ./test/jest.config.js --testPathIgnorePatterns='e2e'",
    "test:ci": "jest --config ./test/jest.config.js --coverage --ci --reporters=default --reporters=jest-junit --testPathIgnorePatterns='e2e'",
    "prisma": "node scripts/prisma-env.js",
    "prisma:generate": "node scripts/prisma-env.js generate",
    "prisma:migrate": "node scripts/prisma-env.js migrate deploy",
    "prisma:migrate:dev": "node scripts/prisma-env.js migrate dev",
    "prisma:studio": "node scripts/prisma-env.js studio",
    "prisma:seed": "node scripts/prisma-env.js db seed",
    "prisma:push": "node scripts/prisma-env.js db push",
    "db:test": "node scripts/test-db-connection.js",
    "smoke": "node scripts/smoke-test.mjs",
    "openapi:dump": "ts-node -P scripts/tsconfig.json --transpile-only scripts/dump-openapi.ts",
    "openapi:typecheck": "tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/lib-storage": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@fastify/cookie": "~11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "nestjs-zod": "^5.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.32",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.1",
    "passport-custom": "^1.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
