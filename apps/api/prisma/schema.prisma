// =============================================================================
// Prisma Schema - OPIFEX
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// User & Identity
// =============================================================================

model User {
  id                      String   @id @default(uuid()) @db.Uuid
  email                   String   @unique
  displayName             String?  @map("display_name")
  providerDisplayName     String?  @map("provider_display_name")
  profileImageUrl         String?  @map("profile_image_url")
  providerProfileImageUrl String?  @map("provider_profile_image_url")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  identities                  UserIdentity[]
  userRoles                   UserRole[]
  userSettings                UserSettings?
  auditEvents                 AuditEvent[]          @relation("ActorEvents")
  settingsUpdates             SystemSettings[]      @relation("SettingsUpdater")
  refreshTokens               RefreshToken[]        @relation("UserRefreshTokens")
  allowlistEntriesAdded       AllowedEmail[]        @relation("AllowlistAddedBy")
  allowlistEntry              AllowedEmail?         @relation("AllowlistClaimedBy")
  deviceCodes                 DeviceCode[]          @relation("UserDeviceCodes")
  storageObjects              StorageObject[]       @relation("UserStorageObjects")
  personalAccessTokens        PersonalAccessToken[] @relation("UserPersonalAccessTokens")
  escalationsAcknowledged     Escalation[]          @relation("EscalationAcknowledgedBy")
  pushSubscriptions           PushSubscription[]
  supervisorProposalsReviewed SupervisorProposal[]  @relation("SupervisorProposalReviewedBy")
  trustGrantsGranted          TrustGrant[]          @relation("TrustGrantsGranted")
  trustGrantsRevoked          TrustGrant[]          @relation("TrustGrantsRevoked")
  approvalRequestsDecided     ApprovalRequest[]     @relation("ApprovalRequestsDecided")

  @@map("users")
}

model UserIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  providerEmail   String?  @map("provider_email")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("user_identities")
}

// =============================================================================
// RBAC - Roles & Permissions
// =============================================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// Settings
// =============================================================================

model SystemSettings {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  value           Json
  version         Int      @default(1)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  updatedByUser User? @relation("SettingsUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model UserSettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// =============================================================================
// Audit
// =============================================================================

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  actorUser User? @relation("ActorEvents", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

// =============================================================================
// Refresh Tokens (for token rotation)
// =============================================================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  // Relations
  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =============================================================================
// Personal Access Tokens (PAT)
// =============================================================================

enum PatDurationUnit {
  minutes
  days
  months
}

model PersonalAccessToken {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  name          String
  tokenHash     String          @unique @map("token_hash")
  tokenPrefix   String          @map("token_prefix")
  durationValue Int             @map("duration_value")
  durationUnit  PatDurationUnit @map("duration_unit")
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz
  lastUsedAt    DateTime?       @map("last_used_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz

  // Relations
  user User @relation("UserPersonalAccessTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

// =============================================================================
// Allowlist (Email Access Control)
// =============================================================================

model AllowedEmail {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  addedById   String?   @map("added_by_id") @db.Uuid
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz
  claimedById String?   @unique @map("claimed_by_id") @db.Uuid
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz
  notes       String?

  // Relations
  addedBy   User? @relation("AllowlistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  claimedBy User? @relation("AllowlistClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  @@map("allowed_emails")
}

// =============================================================================
// Device Authorization Flow (RFC 8628)
// =============================================================================

enum DeviceCodeStatus {
  pending
  approved
  denied
  expired
}

model DeviceCode {
  id         String           @id @default(uuid()) @db.Uuid
  deviceCode String           @unique @map("device_code")
  userCode   String           @unique @map("user_code")
  userId     String?          @map("user_id") @db.Uuid
  status     DeviceCodeStatus @default(pending)
  clientInfo Json?            @map("client_info")
  scopes     String[]
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation("UserDeviceCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceCode])
  @@index([userCode])
  @@index([status, expiresAt])
  @@index([userId])
  @@map("device_codes")
}

// =============================================================================
// Storage Objects
// =============================================================================

enum StorageObjectStatus {
  pending // Upload initiated, awaiting chunks
  uploading // Chunks being uploaded
  processing // Post-upload processing in progress
  ready // Available for use
  failed // Upload or processing failed
}

model StorageObject {
  id              String              @id @default(uuid()) @db.Uuid
  name            String // Original filename
  size            BigInt // Total size in bytes (BigInt for GB-scale)
  mimeType        String              @map("mime_type")
  storageKey      String              @unique @map("storage_key") // S3 object key
  storageProvider String              @default("s3") @map("storage_provider")
  bucket          String?
  status          StorageObjectStatus @default(pending)
  s3UploadId      String?             @map("s3_upload_id") // S3 multipart upload ID
  metadata        Json? // JSONB for flexible metadata
  uploadedById    String?             @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  uploadedBy User?                @relation("UserStorageObjects", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks     StorageObjectChunk[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@map("storage_objects")
}

model StorageObjectChunk {
  id         String   @id @default(uuid()) @db.Uuid
  objectId   String   @map("object_id") @db.Uuid
  partNumber Int      @map("part_number") // S3 part number (1-10000)
  eTag       String   @map("e_tag") // S3 ETag for verification
  size       BigInt // Chunk size in bytes
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  object StorageObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, partNumber])
  @@index([objectId])
  @@map("storage_object_chunks")
}

// =============================================================================
// Opifex Domain - Projects & Repositories
// =============================================================================
//
// VISION §3.3 draws the ownership line these models implement: GitHub holds
// the RECORD OF WORK (issues, branches, PRs, reviews); Opifex holds the STATE
// OF EXECUTION (queue position, run status, heartbeats, cost, quota timers,
// retry counters). Nothing below duplicates something GitHub is authoritative
// about - `issueNumber` is a pointer, not a copy of the issue.

/// A grouping of repositories that share configuration and a budget.
///
/// Deliberately thin. VISION §11 states Opifex is single-operator by design
/// and that multi-user "is not a deferred feature - it is a different
/// product", so a project is an organisational convenience, not a tenancy
/// boundary. A repository may exist without one.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  repositories Repository[]

  @@map("projects")
}

/// A GitHub repository Opifex watches, plus the per-repository policy the
/// reconciler and dispatcher read.
///
/// `observeEnabled` and `dispatchEnabled` are separate on purpose: VISION §12
/// requires an observation week with no dispatch, and #43 needs to end that
/// week ONE REPOSITORY AT A TIME rather than by flipping a global switch.
/// Collapsing them into a single "enabled" flag removes the only safe way to
/// do that.
model Repository {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String? @map("project_id") @db.Uuid

  owner         String
  name          String
  defaultBranch String @default("main") @map("default_branch")

  /// The reconciler reads this repository each tick.
  observeEnabled  Boolean @default(true) @map("observe_enabled")
  /// Work orders for this repository may actually be dispatched to a runner.
  /// Defaults to FALSE: a newly registered repository is observed, never run,
  /// until a human says otherwise.
  dispatchEnabled Boolean @default(false) @map("dispatch_enabled")

  /// Opifex may write `factory/*` mirror labels to this repository.
  ///
  /// A THIRD switch, separate from both `observeEnabled` and
  /// `dispatchEnabled`, because mirror labels are the first thing Opifex ever
  /// writes to a repository and are worth proving on their own. VISION §12's
  /// observation week ends in stages: observe, then write labels, then
  /// dispatch. Collapsing this into `dispatchEnabled` would mean the first
  /// write and the first RUN happen on the same flag flip, which is exactly
  /// the "prove the write path before dispatch exists" step #48 is for.
  ///
  /// Gated a second time by the global `GITHUB_WRITES_ENABLED`: both must be
  /// on for a label to be written.
  mirrorLabelsEnabled Boolean @default(false) @map("mirror_labels_enabled")

  /// Opifex may tell an issue author why their spec was rejected (#155).
  ///
  /// A FOURTH switch rather than a reuse of `mirrorLabelsEnabled`, because the
  /// two writes differ in kind: a mirror label restates a status the operator
  /// already asked to see, and this is unsolicited prose addressed to a human
  /// on their own issue. An operator who turned on labels did not thereby ask
  /// Opifex to start giving people feedback, and VISION §12's staged exit is
  /// only meaningful if each new kind of outward write is its own stage.
  ///
  /// Gated a second time by the global `GITHUB_WRITES_ENABLED`, like every
  /// other write.
  specFeedbackEnabled Boolean @default(false) @map("spec_feedback_enabled")

  /// Per-run spend ceiling in USD, inherited by work orders that do not set
  /// their own. Null means "no repository-level ceiling"; the global ceiling
  /// still applies.
  budgetCeilingUsd        Decimal? @map("budget_ceiling_usd") @db.Decimal(10, 4)
  /// Per-run wall-clock ceiling, inherited the same way.
  wallClockTimeoutMinutes Int?     @map("wall_clock_timeout_minutes")
  /// Default glob path constraints applied to work orders from this
  /// repository. Empty means unconstrained.
  pathConstraints         String[] @map("path_constraints")

  /// Reconciler bookkeeping: when the last tick observed this repository.
  /// Null until the first successful observation.
  lastObservedAt DateTime? @map("last_observed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workOrders       WorkOrder[]
  specRejections   IssueSpecRejection[]
  trustGrants      TrustGrant[]
  approvalRequests ApprovalRequest[]

  @@unique([owner, name])
  @@index([projectId])
  // The reconciler's tick query: "which repositories am I observing, oldest
  // observation first". Both columns are in the index so it never touches the
  // table to order.
  @@index([observeEnabled, lastObservedAt])
  @@map("repositories")
}

/// What Opifex has already told an issue author about their spec.
///
/// ## Why a table and not a lookup
///
/// The reconciler recomputes from scratch every 60 seconds, so an issue whose
/// acceptance criteria are placeholder is rejected again on every tick. Posting
/// a comment each time would bury the issue under the feedback meant to help
/// it — #155 names this as the thing to get right rather than discover.
///
/// The alternative is reading the issue's existing comments to look for a
/// marker, which is what #63 does for the authorization record. That costs a
/// GitHub request per rejected issue per tick, forever, against the budget
/// VISION §11 reserves for the operator's own use. A row costs nothing and the
/// answer never expires.
///
/// ## Why the body digest is the key, not the issue number
///
/// Keyed on the issue alone, an author who reads the feedback, edits the body
/// and gets it wrong again would be met with silence — the worst possible
/// response to someone doing exactly what was asked. The digest means an
/// unchanged body is never re-reported and a changed one always is.
///
/// ## Written only after the comment lands
///
/// This records what was SAID, not what was found. A rejection discovered
/// while `specFeedbackEnabled` was off, or one whose post failed, leaves no
/// row — so enabling the flag later delivers the feedback instead of
/// swallowing it.
model IssueSpecRejection {
  id           String @id @default(uuid()) @db.Uuid
  repositoryId String @map("repository_id") @db.Uuid

  issueNumber Int @map("issue_number")

  /// SHA-256 of the issue body the rejection was computed from.
  bodyDigest String @map("body_digest")

  /// The problems, as the author was told them. Kept so the operator can see
  /// what Opifex actually said without reading GitHub.
  message String

  /// When the comment was successfully posted.
  commentedAt DateTime @default(now()) @map("commented_at") @db.Timestamptz
  /// The comment itself, for the provenance graph (VISION §5).
  commentUrl  String?  @map("comment_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  /// One row per issue, updated in place when the body changes. The tick asks
  /// "have I told them about THIS body", which is a point lookup on this key.
  @@unique([repositoryId, issueNumber])
  @@map("issue_spec_rejections")
}

// =============================================================================
// Opifex Domain - Work Orders
// =============================================================================

/// Where a work order sits in the control loop.
///
/// This is NOT `RunStatus`. A work order is a queue citizen; a run is an
/// execution. `held` and `queued` have no run at all, and `superseded` is the
/// other half of abandon-and-re-run (VISION §3.4) - the abandoned work order
/// keeps its record rather than being deleted, because "we tried this three
/// times" is the input to success metric 4.
enum WorkOrderStatus {
  /// Projected from an issue; the reconciler has not queued it yet.
  pending
  /// Eligible for dispatch, waiting its turn.
  queued
  /// Withheld by policy - a `factory:hold` input label, or an approval gate.
  held
  /// Handed to a runner; a Run exists.
  dispatched
  /// Its run finished successfully.
  succeeded
  /// Its run failed terminally and it was not re-run.
  failed
  /// Needs a human. By VISION §8 it cannot clear its own quarantine.
  quarantined
  /// Abandoned in favour of a later attempt (VISION §3.4).
  superseded
  /// Withdrawn by an operator, or its source issue closed.
  cancelled
}

/// A vendor-neutral, self-contained specification: a repository at a pinned
/// commit plus a task spec, and a projection of a GitHub issue - never an
/// independent source of truth (VISION §4).
///
/// ## Identity
///
/// Identity is deterministic, which is what makes re-runs idempotent: a runner
/// checks whether its branch already exists before doing anything.
///
///   identity  wo_{repo}_{issue}_{baseCommit[0:7]}_a{attempt}
///   branch    factory/{issue}-{baseCommit[0:7]}-a{attempt}
///
/// (VISION §4 writes the placeholders in angle brackets; braces here because
/// GitHub's API strips angle brackets out of issue bodies.)
///
/// Both strings are STORED rather than recomputed on read. Re-run idempotency
/// is built on that string matching exactly, so a consumer that re-derives it
/// can disagree with the control plane about what a work order is -
/// `apps/web/src/types/cockpit.ts` documents the same rule for the UI side.
///
/// ## Attempt counting
///
/// `attempt` is part of the identity, so abandon-and-re-run produces a NEW row
/// rather than mutating this one. Success metric 4, "attempts per work order",
/// is therefore `count(WorkOrder) group by (repositoryId, issueNumber)` - an
/// index lookup, never a scan of `run_events`. The per-run retry counter is a
/// different number and lives on `Run.attemptCount`.
model WorkOrder {
  id           String @id @default(uuid()) @db.Uuid
  /// `wo_opifex_312_a3f91c2_a1`. Unique: this is the idempotency key.
  identity     String @unique
  repositoryId String @map("repository_id") @db.Uuid

  /// The GitHub issue this work order projects. A pointer into the record,
  /// not a copy of it.
  issueNumber Int     @map("issue_number")
  /// The issue's URL and title, copied at projection time.
  ///
  /// Copies rather than pointers, and deliberately: `work-order.schema.json`
  /// REQUIRES `issue.url`, so a row that cannot supply it cannot re-serialize
  /// into the document that was authorised. #63 already caught this shape of
  /// bug once - "validating a field and then dropping it" - and dropping it
  /// here would mean a work order survives a restart as a row nothing can
  /// dispatch. The title moves; that is fine, because what was authorised is
  /// what the authorisation record says, not what the issue says today.
  issueUrl    String  @default("") @map("issue_url")
  issueTitle  String? @map("issue_title")
  /// The pinned base commit, full 40-character SHA. The identity and branch
  /// carry the 7-character prefix; this is the real thing a runner checks out.
  baseCommit  String  @map("base_commit")
  /// 1-based. Bumped by abandon-and-re-run, never mutated in place.
  attempt     Int     @default(1)
  /// `factory/312-a3f91c2-a1`. Unique for the same reason `identity` is: two
  /// work orders must never target one branch.
  branch      String  @unique

  status WorkOrderStatus @default(pending)

  /// The task specification handed to the runner, rendered from the issue.
  taskSpec           String   @map("task_spec")
  /// Testable acceptance criteria, one per element. Non-empty is enforced at
  /// the boundary (#108), not by the column, so an imported legacy row can
  /// still be stored.
  acceptanceCriteria String[] @map("acceptance_criteria")
  /// Glob constraints on what the runner may touch. Empty means the
  /// repository default applies.
  pathConstraints    String[] @map("path_constraints")

  /// What this work order needs from a runner (VISION §6).
  ///
  /// The ROUTING INPUT, and the reason it has to be stored: `decide(needs, …)`
  /// is how #64 matches a work order to a runner without the work order ever
  /// naming one. A row without it cannot be routed at all, so a queued work
  /// order would be undispatchable after a restart.
  ///
  /// Free strings at the column, a closed union at the boundary
  /// (`RunnerNeed`). Postgres cannot express the union, and widening it later
  /// must not require a migration on a table that holds authorisation records.
  needs String[] @default([])

  /// Resolved ceilings - the repository defaults are copied in at projection
  /// time rather than read through, so changing a repository's budget cannot
  /// retroactively change what an in-flight run was authorised to spend.
  budgetCeilingUsd        Decimal? @map("budget_ceiling_usd") @db.Decimal(10, 4)
  wallClockTimeoutMinutes Int?     @map("wall_clock_timeout_minutes")

  /// Provenance (VISION §5). ADR identifiers such as `ADR-0042` that informed
  /// this work, and the issue-comment URL of the authorization record once
  /// dispatch has posted it.
  decisionRefs            String[] @map("decision_refs")
  authorizationCommentUrl String?  @map("authorization_comment_url")

  /// Why it is held or quarantined, in one line, for the cockpit. Null
  /// whenever the status is neither.
  holdReason String? @map("hold_reason")

  queuedAt  DateTime? @map("queued_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runs       Run[]

  // Belt and braces alongside the unique `identity`: the identity string is
  // built from exactly these four columns, so a bug that formats it wrongly
  // still cannot produce a duplicate attempt.
  @@unique([repositoryId, issueNumber, baseCommit, attempt])
  // Attempt counting per issue (success metric 4) without scanning events.
  @@index([repositoryId, issueNumber])
  // The queue screen: what is waiting, oldest first.
  @@index([status, queuedAt])
  @@map("work_orders")
}

// =============================================================================
// Opifex Domain - Runs
// =============================================================================

/// The lifecycle state of a run as the operator reads it.
///
/// Mirrors `RunStatus` in `apps/web/src/types/cockpit.ts` exactly - that union
/// is the vocabulary the status colour tokens and the status registry are
/// keyed by, and a drift between the two would silently render an unknown
/// status as a blank chip.
///
/// Derived from VISION §9's three failure modes plus the two non-failure
/// states, and deliberately NOT a mirror of the six normalized event types:
/// events are what a runner REPORTS, a status is what the control plane
/// CONCLUDED. `stalled` and `quarantined` have no corresponding event at all -
/// they are watchdog and policy verdicts.
enum RunStatus {
  /// Events are flowing; nothing to do.
  running
  /// Completed, pull request open.
  succeeded
  /// Silent or looping; the response is to kill and re-run.
  stalled
  /// Parked with a reset time; auto-resumes without a human.
  blocked
  /// Terminal failure.
  failed
  /// Needs a human; by VISION §8 it cannot clear its own quarantine.
  quarantined
}

/// One execution of one work order by one runner.
///
/// A run outlives a single invocation of the runner: VISION §9's `blocked`
/// response is "park, auto-resume with jitter", and each resume is a fresh
/// invocation against the same work order. Those invocations are `RunAttempt`
/// rows; the operator-facing status, cost and liveness live here so the
/// cockpit has one row per unit of work rather than one per retry.
model Run {
  id          String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid

  /// Which runner executed it - `claude-code-local`, `claude-code-cloud`.
  /// A foreign key onto `Runner.key` rather than its uuid: the key is what
  /// the `Runner:` commit trailer records, so joining on it means the trailer
  /// and the database agree by construction.
  runnerKey     String  @map("runner_key")
  /// The runner's own version string, for the `Runner:` commit trailer.
  runnerVersion String? @map("runner_version")

  status RunStatus @default(running)

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz

  /// When the last event of ANY source arrived. Null until the first one does.
  ///
  /// This - not `startedAt` - is what the watchdog and the attention panel
  /// measure age from, and it is denormalized out of `run_events` on purpose:
  /// "which runs have been silent for longer than their threshold" must be an
  /// index scan over a few hundred runs, not an aggregate over an unbounded
  /// event table.
  lastEventAt DateTime? @map("last_event_at") @db.Timestamptz
  /// ISO reset time for a `blocked` run; null for every other status. The
  /// watchdog resumes at this time plus jitter.
  resumesAt   DateTime? @map("resumes_at") @db.Timestamptz

  /// One line: what the watchdog concluded and what the operator should do.
  /// Populated only when a HUMAN must act. `resumesAt` is the "the system will
  /// handle it" signal, and the two are separate fields because collapsing
  /// them into one message destroys exactly the distinction the operator
  /// needs (see `RunSummary` in the web types).
  attentionReason String? @map("attention_reason")
  /// Why the run stopped, in the runner's own words, for the run-summary PR
  /// comment.
  stopReason      String? @map("stop_reason")

  /// How many times the runner has been invoked for this run: 1 on dispatch,
  /// incremented by each auto-resume or kill-and-retry. Denormalized from
  /// `RunAttempt` so the quarantine threshold is a column comparison.
  attemptCount Int @default(0) @map("attempt_count")

  /// Cumulative spend. Null when the runner reports no cost at all - VISION §6
  /// makes cost reporting a declared capability, so "unknown" and "zero" are
  /// genuinely different and must not both be 0.
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 4)
  tokensInput  Int?     @map("tokens_input")
  tokensOutput Int?     @map("tokens_output")

  /// Present once the run has opened a pull request.
  pullRequestUrl    String? @map("pull_request_url")
  pullRequestNumber Int?    @map("pull_request_number")
  /// The head commit the run left on its branch, for the git-derived liveness
  /// watcher to compare against.
  headCommit        String? @map("head_commit")

  /// What became of the pull request this run opened (#215).
  ///
  /// Distinguishes MERGED from CLOSED-UNMERGED from still open, because those
  /// are three different facts about the same work: a PR closed without merging
  /// is not awaiting review, and folding the two together would make
  /// first-pass acceptance (success metric 3) look better than it is.
  ///
  /// Null while the pull request is still open, or before the sweep has read
  /// it — which is also the sweep's own query.
  pullRequestState    PullRequestOutcome? @map("pull_request_state")
  /// When it merged. Null unless `pullRequestState` is `merged`.
  pullRequestMergedAt DateTime?           @map("pull_request_merged_at") @db.Timestamptz

  /// When the VISION §5 run summary was posted to GitHub (#67).
  ///
  /// A column rather than a re-read of the pull request's comments, because
  /// the sweep that posts these runs on a schedule: asking GitHub "did I
  /// already say this" once per concluded run per sweep spends rate limit on a
  /// question the control plane can answer itself. Null means the summary is
  /// still owed, which is exactly the sweep's query.
  summaryPostedAt DateTime? @map("summary_posted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  attempts    RunAttempt[]
  runner      Runner       @relation(fields: [runnerKey], references: [key], onDelete: Restrict)
  events      RunEvent[]
  escalations Escalation[]

  @@index([workOrderId])
  // The watchdog's whole query: live runs ordered by how long they have been
  // silent. `status` first because it is the selective half.
  @@index([status, lastEventAt])
  // The blocked-run sweeper: "what is due to resume".
  @@index([resumesAt])
  // The runs list, newest first.
  @@index([startedAt])
  // The run-summary sweep: concluded runs that still owe one (#67).
  @@index([summaryPostedAt, status])
  // The merge-state sweep, and metric 3's denominator (#215).
  @@index([pullRequestState])
  // The dispatcher's concurrency gate: how many live runs this runner has.
  @@index([runnerKey, status])
  @@map("runs")
}

/// What became of a run's pull request (#215).
///
/// `closed` means closed WITHOUT merging, which is a different outcome from
/// merged and from open. Success metric 3 counts merges; counting a closed PR
/// as anything but a non-merge would flatter the number VISION §10 says
/// decides the roadmap.
enum PullRequestOutcome {
  merged
  closed
}

/// How one invocation of the runner ended.
enum RunAttemptOutcome {
  /// Still in flight.
  running
  succeeded
  /// The runner reported a terminal failure.
  failed
  /// The watchdog killed it - silent or looping (VISION §9).
  killed
  /// Parked on a structured block reason; a later attempt resumes it.
  blocked
}

/// One invocation of a runner inside a run.
///
/// First-class and countable because VISION §3.4's recovery model is abandon
/// and re-run: "how many times did we have to poke this" is an operational
/// number, and answering it by counting `run.started` events would conflate a
/// re-invocation with a runner that emits its start event twice.
model RunAttempt {
  id     String @id @default(uuid()) @db.Uuid
  runId  String @map("run_id") @db.Uuid
  /// 1-based within the run.
  number Int

  outcome RunAttemptOutcome @default(running)

  /// The runner's own handle for this invocation - a session id, a job id -
  /// so a run can be correlated back to vendor-side logs. Opaque to Opifex.
  runnerRunId String? @map("runner_run_id")

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz

  /// Why this invocation ended, one line.
  stopReason   String?   @map("stop_reason")
  /// Structured block reason with its reset time, when the outcome is
  /// `blocked` - a rate limit, a quota window. What the resume schedule reads.
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz

  costUsd Decimal? @map("cost_usd") @db.Decimal(10, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, number])
  @@index([runId])
  @@index([outcome])
  @@map("run_attempts")
}

// =============================================================================
// Opifex Domain - Runners
// =============================================================================

/// How the control plane invokes a runner (VISION §6).
enum RunnerInvocationModel {
  /// Opifex spawns the process and owns its lifetime.
  process
  /// Opifex calls an HTTP API and gets a handle back.
  http_api
  /// Opifex hands the job to a vendor scheduler and polls it.
  hosted_job
}

/// Where the runner's work physically happens.
enum RunnerExecutionLocus {
  /// Our own infrastructure - local filesystem, private services reachable.
  own_infrastructure
  /// The vendor's cloud. Free compute, real parallelism, no private network.
  vendor_cloud
}

/// How much of what the runner is doing Opifex can actually see.
///
/// VISION §6 states plainly that equal observability across vendors is not
/// achievable; a common floor that some runners exceed is. This enum is that
/// floor made explicit so the control plane can DEGRADE rather than break:
/// `full` enables event-age watchdogs and tool-loop detection, `none` falls
/// back to wall-clock timeouts and git-derived liveness.
enum RunnerStreamingFidelity {
  /// Per-turn and per-tool-call events, live.
  full
  /// Coarse progress only - phase transitions, no tool detail.
  partial
  /// Nothing until the run ends. Liveness must come from git.
  none
}

/// How trustworthy a runner's rate-limit and quota reporting is.
enum RunnerSignalQuality {
  /// Structured reason plus a reset timestamp. The `blocked` response works.
  structured
  /// An error string that has to be pattern-matched. Fragile but usable.
  heuristic
  /// Nothing. Exhaustion is indistinguishable from failure.
  none
}

/// How much a runner may be trusted with, independent of what it can do.
enum RunnerStabilityTier {
  experimental
  beta
  stable
}

/// A registered runner: an implementation of the VISION §6 seam.
///
/// Work orders never name a runner. Dispatch routes a work order's declared
/// NEEDS against advertised capabilities, which is why the capability manifest
/// is a table Opifex can query rather than a constant in the runner's own code.
model Runner {
  id  String @id @default(uuid()) @db.Uuid
  /// The stable identifier used everywhere else in the system, including
  /// `Run.runnerKey` and the `Runner:` commit trailer - `claude-code-local`.
  key String @unique

  displayName String  @map("display_name")
  /// The implementation version this registration describes. The trailer
  /// records `key@version`, so a capability change is traceable to a version.
  version     String
  /// Whether dispatch may route to it at all. A runner can be registered and
  /// switched off without losing its history.
  enabled     Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  capability RunnerCapability?
  runs       Run[]

  @@index([enabled])
  @@map("runners")
}

/// What a runner declares it can do (VISION §6).
///
/// One row per runner rather than columns on `Runner`, because this is the
/// manifest - a document with its own schema version that a runner supplies
/// and Opifex validates, not fields Opifex assigns.
model RunnerCapability {
  id       String @id @default(uuid()) @db.Uuid
  runnerId String @unique @map("runner_id") @db.Uuid

  /// Version of `schemas/runner-capability.schema.json` this manifest claims
  /// to conform to. Stored so an old manifest stays readable after the schema
  /// moves on.
  schemaVersion String @map("schema_version")

  invocationModel   RunnerInvocationModel   @map("invocation_model")
  executionLocus    RunnerExecutionLocus    @map("execution_locus")
  streamingFidelity RunnerStreamingFidelity @map("streaming_fidelity")
  rateLimitSignal   RunnerSignalQuality     @map("rate_limit_signal")
  stabilityTier     RunnerStabilityTier     @map("stability_tier")

  /// Whether the runner reports what a run cost. False is why `Run.costUsd`
  /// is nullable rather than defaulting to zero.
  reportsCost    Boolean @default(false) @map("reports_cost")
  /// Vendor-specific session resumption. VISION §3.4: allowed as an
  /// optimization, never load-bearing - recovery is always abandon-and-re-run.
  resumable      Boolean @default(false)
  /// How many runs it will accept at once. The dispatcher's concurrency gate.
  maxConcurrency Int     @default(1) @map("max_concurrency")

  /// Glob patterns of branches the runner may write to. Empty means the
  /// control plane's own default applies. This is a declaration, not the
  /// enforcement point - VISION §8's protected-branch rule is enforced by
  /// there being no adapter for it.
  branchPatterns String[] @map("branch_patterns")

  /// The raw manifest as supplied, kept verbatim alongside the parsed columns
  /// so a field this schema does not model yet is not silently discarded.
  manifest Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@map("runner_capabilities")
}

// =============================================================================
// Opifex Domain - Run Events
// =============================================================================

/// The six normalized event types. Every runner maps into these (VISION §9).
///
/// NOT a mirror of `RunStatus`, and the two must never be collapsed: an event
/// is what a runner REPORTED, a status is what the control plane CONCLUDED.
/// `stalled` and `quarantined` have no event because no runner ever reports
/// them - they are watchdog and policy verdicts.
///
/// The dotted names are mapped through, because `run.started` is the wire
/// value in `schemas/run-event.schema.json` and a Postgres enum label cannot
/// contain a dot.
enum RunEventType {
  run_started   @map("run.started")
  run_heartbeat @map("run.heartbeat")
  run_progress  @map("run.progress")
  run_blocked   @map("run.blocked")
  run_completed @map("run.completed")
  run_failed    @map("run.failed")
}

/// Where an event came from. VISION §9 is emphatic:
///
/// > a synthesized event must never masquerade as a report.
///
/// Which is why `RunEvent.source` is NOT NULL with no default - a caller that
/// forgets to say where an event came from gets an error, not a plausible
/// guess. Two independent liveness sources buy nothing unless the operator can
/// tell which one spoke.
enum RunEventSource {
  /// The runner's own structured stream. Rich, vendor-specific.
  runner
  /// Derived from git: a commit landed, a PR transitioned, CI fired.
  /// Universal - works for every coding agent that exists or will exist.
  git
  /// Manufactured by the control plane itself: a watchdog kill, a timeout.
  control_plane @map("control-plane")
}

/// One normalized event on the run timeline.
///
/// This is the high-volume table and is designed as one. VISION §5 places the
/// event stream, heartbeats and token detail in **Postgres only** - the single
/// deliberate exception to "everything lands in GitHub", because telemetry at
/// this volume in issue comments would destroy the record it exists to support.
///
/// ## Retention
///
/// This table grows without bound and nothing else in the schema does. The
/// strategy, decided here rather than discovered later:
///
///  - Events for a run in a terminal state (`succeeded`, `failed`) are kept
///    30 days, which is long enough to investigate a merged PR's history.
///  - Events for `quarantined` runs are kept indefinitely - a quarantine is
///    unresolved by definition, and its evidence is the whole point.
///  - `run.heartbeat` is prunable after 7 days regardless of run state: it
///    carries no payload beyond its own timestamp, and `Run.lastEventAt`
///    already holds the only fact anyone reads it for.
///  - Deletion runs as a scheduled task next to the existing cleanup tasks in
///    `auth/tasks`, `device-auth/tasks` and `storage/tasks`.
///
/// Partitioning by `occurredAt` is the escalation if pruning stops keeping up;
/// it is deliberately NOT done now, because a single-operator install
/// (VISION §11) will not reach the volume that justifies the operational cost.
model RunEvent {
  id    String @id @default(uuid()) @db.Uuid
  runId String @map("run_id") @db.Uuid

  /// The id the SENDER chose, from `run-event.schema.json`.
  ///
  /// This is what makes ingestion idempotent, and both event sources need it
  /// for different reasons: a runner retrying a delivery reuses its id (#53),
  /// and the git watcher re-observes the same commit on every tick and derives
  /// the same id from it (#52). Without a unique constraint here, a stalled
  /// run whose branch is re-read each minute would accumulate a fresh
  /// "progress" event every tick and look permanently alive — the exact
  /// failure #54 exists to catch, introduced by the liveness source itself.
  ///
  /// Unique per RUN rather than globally: senders choose these, and two
  /// runners have no way to coordinate. Nullable so a control-plane event that
  /// has no natural sender id can be written without inventing one.
  externalId String? @map("external_id")

  type   RunEventType
  /// NO DEFAULT, NOT NULL. See `RunEventSource` - this discriminator is
  /// load-bearing, not metadata.
  source RunEventSource

  /// When the event actually happened, per its source - not when Opifex
  /// stored it. The watchdog measures age from this.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz
  /// When Opifex recorded it. The gap between the two IS detection latency,
  /// success metric 1, so both are kept.
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  /// One line, already rendered for humans by the API.
  summary String

  /// The tool or turn signature, when the runner reports one. VISION §9's
  /// looping detection is "events flowing, tool signature repeating", so this
  /// column is what makes that check a query rather than a payload scan.
  toolSignature String? @map("tool_signature")

  /// Structured reason and reset time for a `run.blocked` event.
  blockedReason String?   @map("blocked_reason")
  blockedUntil  DateTime? @map("blocked_until") @db.Timestamptz

  /// Incremental cost and tokens attributed to this event, where the runner
  /// reports them. Null means not reported, never zero.
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 4)
  tokensInput  Int?     @map("tokens_input")
  tokensOutput Int?     @map("tokens_output")

  /// OpenTelemetry correlation: VISION §9 maps one trace per work order and
  /// one span per turn or tool call.
  traceId String? @map("trace_id")
  spanId  String? @map("span_id")

  /// The event as received, for anything these columns do not model.
  payload Json?

  // Relations
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Idempotency, and the lookup that enforces it.
  @@unique([runId, externalId])
  // The run detail timeline.
  @@index([runId, occurredAt])
  // The watchdog's access pattern is BY EVENT AGE, which #39 calls out as
  // load-bearing rather than an optimization: "which runs have gone quiet".
  @@index([occurredAt])
  // Loop detection: the same tool signature repeating within one run.
  @@index([runId, toolSignature])
  // Heartbeat pruning (see the retention note above) without a full scan.
  @@index([type, occurredAt])
  @@map("run_events")
}

// =============================================================================
// Opifex Domain - Escalations
// =============================================================================

/// Why a human is being interrupted.
enum EscalationKind {
  /// No events at all - the run is silent (VISION §9).
  run_stalled
  /// Events flowing, tool signature repeating.
  run_looping
  /// Terminal failure that policy will not re-run.
  run_failed
  /// Policy put the work order in quarantine; only a human clears it.
  quarantined
  /// A ceiling was hit - spend or wall clock.
  budget_exceeded
  /// The control plane itself is in a state it cannot resolve.
  system
}

/// How far an escalation got.
///
/// The whole reason this is a lifecycle rather than a boolean: VISION §9 says
/// escalation is AN ACTION, not telemetry, and "we tried to tell you and the
/// push failed" must be distinguishable from "we never noticed". A record that
/// only says an escalation was raised cannot tell those apart, and the second
/// is the failure this system exists to eliminate.
enum EscalationStatus {
  /// Recorded, not yet handed to a transport.
  raised
  /// Handed to a transport, no receipt yet.
  dispatched
  /// The transport confirmed delivery.
  delivered
  /// The transport failed, permanently. `failureReason` says why.
  failed
  /// A human confirmed they saw it.
  acknowledged
  /// The underlying condition cleared before anyone acted.
  resolved
}

/// One attempt to get a human's attention.
/// A browser push subscription: one device an operator can be reached on.
///
/// VISION §8 sets the bar at *"one tap from a phone"*, and #58 is explicit
/// that everything upstream can work perfectly while detection latency is
/// still measured in hours if nobody is actually told.
model PushSubscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The push service URL the browser issued.
  ///
  /// Unique because it IS the device's identity in the Web Push protocol: a
  /// browser re-subscribing with the same key material gets the same
  /// endpoint back, and inserting a second row for it would push twice to
  /// one phone.
  endpoint String @unique
  /// The subscription's public key and auth secret, for payload encryption.
  /// The payload is encrypted end to end - the push service relays bytes it
  /// cannot read, which is why escalation detail can travel through it.
  p256dh   String
  auth     String

  /// What subscribed, so an operator revoking a device can tell which it is.
  userAgent String? @map("user_agent")

  /// Consecutive delivery failures, and when each side last happened.
  ///
  /// A push service answering 404 or 410 means the subscription is
  /// permanently gone; anything else may be transient. Kept per subscription
  /// rather than inferred from escalations so a dead phone can be pruned
  /// without reading the escalation history.
  failureCount  Int       @default(0) @map("failure_count")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Escalation {
  id    String  @id @default(uuid()) @db.Uuid
  /// The run this is about. Null for a `system` escalation, which has no run.
  runId String? @map("run_id") @db.Uuid

  kind   EscalationKind
  status EscalationStatus @default(raised)

  /// One line: what happened and what the operator should do about it.
  summary String
  /// Detail for the notification body.
  detail  String?

  /// When the run actually stopped making progress: the `occurredAt` of the
  /// last event of ANY source before the silence.
  ///
  /// The STOP side of success metric 1. VISION §10 defines detection latency
  /// as "the elapsed time between a run ceasing to make progress and a human
  /// being informed", so without this column the system can only measure from
  /// when it noticed - which would report success while the operator still
  /// finds out four hours later. Null for a `system` escalation, which is
  /// about the control plane and has no run that stopped.
  progressStoppedAt DateTime? @map("progress_stopped_at") @db.Timestamptz

  /// Which liveness source the stall was measured through.
  ///
  /// VISION §9 runs two INDEPENDENT liveness sources, and #59 requires the
  /// metric say which one was carrying a run when it went quiet. A
  /// git-derived detection is expected to be slower than a runner-reported
  /// one; an aggregate that blends them hides which half needs work.
  detectionSource RunEventSource? @map("detection_source")

  /// Milliseconds from `progressStoppedAt` to `raisedAt`, and to
  /// `deliveredAt`.
  ///
  /// Derived, and stored anyway. The cockpit (#20) needs percentiles over
  /// thousands of rows; as timestamp arithmetic over nullable columns that is
  /// a scan, and as an indexed integer it is not. Both are kept because
  /// stop-to-raised and stop-to-notified answer different questions, and only
  /// the second is the success metric.
  detectLatencyMs Int? @map("detect_latency_ms")
  notifyLatencyMs Int? @map("notify_latency_ms")

  /// Which transport was used - `push`, `email`. Null until dispatched.
  transport        String?
  /// The transport's own receipt id, for reconciling a delivery webhook.
  receiptId        String? @map("receipt_id")
  /// Why delivery failed, when it did. Populated only for `failed`.
  failureReason    String? @map("failure_reason")
  /// How many delivery attempts have been made.
  deliveryAttempts Int     @default(0) @map("delivery_attempts")

  raisedAt         DateTime  @default(now()) @map("raised_at") @db.Timestamptz
  dispatchedAt     DateTime? @map("dispatched_at") @db.Timestamptz
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz
  /// Who acknowledged. Null while unacknowledged.
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  run              Run?              @relation(fields: [runId], references: [id], onDelete: Cascade)
  acknowledgedBy   User?             @relation("EscalationAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  approvalRequests ApprovalRequest[] @relation("ApprovalRequestEscalation")

  @@index([runId])
  // The escalation queue: what is outstanding, oldest first.
  @@index([status, raisedAt])
  // The redelivery sweeper: raised or dispatched, never delivered.
  @@index([status, deliveryAttempts])
  // Success metric 1, aggregated for the cockpit: detection latency over a
  // window, split by which liveness source detected the stop.
  @@index([detectionSource, raisedAt])
  @@map("escalations")
}

// =============================================================================
// Opifex Domain - Reconciliation Log
// =============================================================================

/// One reconciler tick, recorded whether or not it did anything.
///
/// ## Why not `AuditEvent`
///
/// #50 asks for this decision to be made deliberately and written down, on the
/// true premise that `AuditEvent` is written by four services today rather
/// than being unused. It is reused for none of this, for three reasons:
///
///  1. **No actor.** Every `AuditEvent` row answers "which user did what to
///     which target". A tick has no user — it is the control plane acting on
///     its own schedule. Storing a null actor on every row would make the
///     column meaningless for the rows that do have one.
///  2. **Volume.** A tick a minute is ~1,440 rows a day, indefinitely, against
///     a table currently holding a handful of user-audit rows per day. Mixing
///     them buries the audit trail in telemetry and makes the audit table's
///     indexes carry traffic they were never designed for.
///  3. **Retention.** These are prunable within weeks; user-audit rows are
///     exactly the kind of record you do not quietly delete. One table cannot
///     have two retention policies, and inheriting the stricter one for
///     telemetry means keeping gigabytes forever.
///
/// ## Retention, and the payload split
///
/// #50 requires a retention policy from day one, and there is a tension: every
/// tick must be recorded (a log with gaps cannot be reviewed — a missing entry
/// is indistinguishable from a tick that never ran), but a full state
/// projection attached to every tick grows without bound.
///
/// Resolved by splitting the row: every tick writes a summary row, and the
/// heavy `projections`/`actions` JSON is stored ONLY when the tick had
/// something to say — it computed actions, or it failed. A quiet tick in a
/// healthy factory is a few hundred bytes. `ReconcileTickCleanupTask` prunes
/// rows past `RECONCILER_LOG_RETENTION_DAYS` (default 14, deliberately longer
/// than the one-week observation window so the week is still reviewable at the
/// end of it).
model ReconcileTick {
  id String @id @default(uuid()) @db.Uuid

  startedAt  DateTime @map("started_at") @db.Timestamptz
  finishedAt DateTime @map("finished_at") @db.Timestamptz
  durationMs Int      @map("duration_ms")

  /// `completed`, `partial`, `failed`, `skipped-locked`, `skipped-disabled`,
  /// `skipped-rate-limited`. A plain string rather than an enum: outcomes are
  /// a diagnostic vocabulary that will grow as the loop does, and a migration
  /// per new outcome buys nothing here.
  outcome String

  repositoriesObserved Int @map("repositories_observed")
  /// How many actions the tick COMPUTED. During the observation week nothing
  /// executes them, which is why this is separate from any executed count.
  actionsComputed      Int @map("actions_computed")
  /// How many were actually performed. Zero for the whole observation week,
  /// and the column exists from the start so "we thought we were read-only"
  /// is checkable against the log rather than against memory.
  actionsExecuted      Int @default(0) @map("actions_executed")

  /// True when every GitHub read was answered from the ETag cache. The number
  /// that says whether polling is affordable at all (#40).
  allFromCache       Boolean @map("all_from_cache")
  rateLimitRemaining Int?    @map("rate_limit_remaining")

  /// Per-repository failures, `[{ repository, reason }]`. Always present.
  failures Json

  /// The computed desired state, stored only for a tick that had something to
  /// say. Null on a quiet tick — see the retention note above.
  projections Json?
  /// The action list with its reasons and evidence. Null on a quiet tick.
  ///
  /// This is the deliverable of VISION §12's observation week: reviewing what
  /// the reconciler WOULD have done, before it could do any of it.
  actions     Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // The review query: newest first, and the pruning query, both covered.
  @@index([startedAt])
  // "Show me the ticks that did something", which is how a week of log is
  // actually read.
  @@index([outcome, startedAt])
  @@map("reconcile_ticks")
}

// =============================================================================
// Opifex Domain - The AI Supervisor (VISION §7), observe-only
// =============================================================================

/// Why an invocation ended the way it did.
enum SupervisorInvocationOutcome {
  /// The supervisor ran and its proposers all reported.
  completed
  /// It ran, but at least one proposer errored. The rest still recorded.
  partial
  /// It errored before any proposer reported.
  failed
  /// Skipped because the supervisor is turned off (#89).
  skipped_disabled
  /// Skipped because worker quota was scarce (#89). Diagnosis is worth less
  /// than execution, so when the two compete, execution wins.
  skipped_quota
}

/// Whether a proposer proposed anything.
///
/// #90: "The log also needs to record proposals the supervisor DECLINED to
/// make, or the approval-rate measurement the promotion ladder computes (#99)
/// is biased: an action class that is never proposed looks the same as one
/// that is always proposed correctly."
enum SupervisorProposalOutcome {
  /// The supervisor is proposing an action a human could approve.
  proposed
  /// The supervisor looked and had nothing to propose. Still a row.
  declined
}

/// A human's verdict on a proposal, which is the Phase 6 measurement.
enum SupervisorProposalReview {
  /// Nobody has judged it yet. The default, and the review queue's query.
  pending
  /// A human would have approved this had the class been promoted.
  would_approve
  /// A human would have rejected it.
  would_reject
}

/// One scheduled run of the supervisor (#89), and the snapshot it saw (#88).
///
/// ## Why the snapshot lives here and not on each proposal
///
/// #88 requires the snapshot be "persisted with the proposal that came from
/// it", because "what did it actually know?" is the first question when
/// reviewing a proposal. One invocation renders ONE snapshot and may produce
/// several proposals from it, so storing the text per proposal would copy the
/// same 6-8 KB N times to express a fact the foreign key already carries. A
/// proposal reaches its snapshot through `invocation`, and the link is exact
/// either way.
///
/// ## Why the text is stored at all
///
/// It is the only replayable record of the model's input. `SnapshotService`
/// could re-query Postgres, but it would re-query TODAY's Postgres, and a
/// proposal reviewed a week later would then be judged against a factory that
/// has moved. `renderSnapshot` being pure is what makes the stored text
/// authoritative rather than indicative.
model SupervisorInvocation {
  id String @id @default(uuid()) @db.Uuid

  startedAt  DateTime @map("started_at") @db.Timestamptz
  finishedAt DateTime @map("finished_at") @db.Timestamptz
  durationMs Int      @map("duration_ms")

  outcome SupervisorInvocationOutcome

  /// The model that was asked. Recorded per invocation because #89 requires
  /// cost accounting per model, and because "a small model" is a claim that
  /// should be checkable against the log rather than against the config file
  /// as it reads today.
  model String

  /// The exact text handed to the model. Empty for a skipped invocation,
  /// which renders no snapshot at all.
  snapshotText        String    @map("snapshot_text")
  /// SHA-256 of `snapshotText`. Lets two invocations be compared for "did
  /// anything change" without loading both bodies.
  snapshotHash        String    @map("snapshot_hash")
  /// The instant the snapshot describes - `SnapshotInput.generatedAt`, the
  /// value every age in the text was rendered relative to.
  snapshotGeneratedAt DateTime? @map("snapshot_generated_at") @db.Timestamptz
  /// Whether the snapshot dropped rows. Stored because a proposal made from a
  /// partial view of the factory carries a bias a reviewer must be able to
  /// see, and #88 makes truncation explicit precisely so it can be recorded.
  snapshotTruncated   Boolean   @default(false) @map("snapshot_truncated")
  snapshotCharacters  Int       @default(0) @map("snapshot_characters")

  /// What the invocation cost.
  ///
  /// SEPARATE from `Run.costUsd` by construction - a different table entirely
  /// - because #89 requires supervisor cost never distort success metric 5.
  /// Cost per merged pull request is about the work, and the supervisor merges
  /// nothing. Null when the adapter reports no cost (VISION §6 again: unknown
  /// and zero are different).
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 4)
  tokensInput  Int?     @map("tokens_input")
  tokensOutput Int?     @map("tokens_output")

  /// Why it failed or was skipped. Null for a clean invocation.
  failureReason String? @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  proposals SupervisorProposal[]

  // The log, newest first - the review screen's query.
  @@index([startedAt])
  // "Which invocations actually produced something", and the retention sweep.
  @@index([outcome, startedAt])
  @@map("supervisor_invocations")
}

/// One thing the supervisor would have done, and executed nothing about.
///
/// ## Proposals only, structurally
///
/// There is no `executedAt`, no `appliedBy`, no status that means "done".
/// #90: execution "must be structurally impossible, not merely unimplemented"
/// - so the row cannot even RECORD an execution, and a future PR trying to
/// execute one has to add a column and change a migration to say so. VISION
/// §3.6: "a system whose safety depends on a model being right has no safety
/// property at all", and the same holds for one whose safety depends on nobody
/// wiring up an executor later.
///
/// ## Why the action class is a string
///
/// ADR-0011. The taxonomy is `apps/api/src/supervisor/action-classes.ts` and
/// the column is validated against it at the boundary. A Prisma enum would
/// make adding an action class a MAJOR schema bump (ADR-0010) on a table that
/// exists to accumulate evidence, and adding a class as the supervisor grows
/// is an ordinary event.
model SupervisorProposal {
  id           String @id @default(uuid()) @db.Uuid
  invocationId String @map("invocation_id") @db.Uuid

  /// An `ActionClassId`. The partition key for every approval rate #99 will
  /// compute, which is why ADR-0011 spent a decision on its granularity.
  actionClass String                    @map("action_class")
  outcome     SupervisorProposalOutcome

  /// One line: what is proposed, or why nothing was.
  summary   String
  /// The supervisor's reasoning, in its own words. This is what a reviewer
  /// judges - an approval rate over proposals nobody could read would measure
  /// agreement with a conclusion rather than with an argument.
  reasoning String

  /// What the proposal is about: `run`, `work-order`, `issue`, or `factory`
  /// for something with no single subject. Free strings at the column and a
  /// closed union at the boundary, like `needs` on WorkOrder.
  targetKind String? @map("target_kind")
  /// The subject's stable identifier - a run uuid, a work order identity, an
  /// `owner/name#number`. Not a foreign key: a proposal about an issue that
  /// has no work order yet has nothing to point at, and a proposal must
  /// outlive the row it discusses or the evidence disappears with it.
  targetRef  String? @map("target_ref")

  /// Class-specific structure: the child issues a decomposition proposes, the
  /// acceptance criteria a shaping proposal drafts. Shape belongs to the
  /// proposer; this column deliberately does not constrain it.
  details Json?

  /// Whether a human would have approved. THE Phase 6 measurement.
  review       SupervisorProposalReview @default(pending)
  reviewedAt   DateTime?                @map("reviewed_at") @db.Timestamptz
  /// Who judged it. Null while pending, and on SetNull if that user is
  /// deleted - the verdict outlives the account that recorded it.
  reviewedById String?                  @map("reviewed_by_id") @db.Uuid
  /// Why, when the reviewer says. Optional: a rejection with no reason is
  /// still evidence, and demanding prose would suppress the fast verdicts
  /// that make a review queue survivable.
  reviewNote   String?                  @map("review_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  invocation       SupervisorInvocation @relation(fields: [invocationId], references: [id], onDelete: Cascade)
  reviewedBy       User?                @relation("SupervisorProposalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  trustGrants      TrustGrant[]         @relation("TrustGrantsFromProposal")
  approvalRequests ApprovalRequest[]    @relation("ApprovalRequestsFromProposal")

  @@index([invocationId])
  // The measurement query: per class, what fraction was approved.
  @@index([actionClass, review])
  // The review queue: what nobody has judged yet, oldest first.
  @@index([review, createdAt])
  // "What has been proposed about this run/work order", for the run detail
  // screen and for the diagnosis that lands on a run summary.
  @@index([targetKind, targetRef])
  @@map("supervisor_proposals")
}

// =============================================================================
// Opifex Domain - Trust Grants
// =============================================================================

/// Where a trust grant stands in its lifecycle.
///
/// `suspended` and `revoked` are deliberately different terminal-ish states.
/// VISION §8: auto-revoke "suspends the grant and explains why" - that is the
/// SYSTEM's judgement, on evidence, and is reversible by a human who disagrees
/// with the evidence. `revoked` is the HUMAN's judgement and nothing here
/// reverses it. Collapsing the two into one status would make an automatic
/// suspension read as final, and a human's revocation read as negotiable -
/// backwards for both.
enum TrustGrantStatus {
  /// Currently authorizing autonomous execution.
  active
  /// `expiresAt` passed with no renewal. #115's "silence revokes".
  expired
  /// A human ended it directly. Terminal - nothing reactivates a revoked
  /// grant; a human who wants trust restored issues a new one.
  revoked
  /// The SYSTEM ended it, on evidence: failure rate, cost-per-action, or a
  /// class demotion. Reversible - a human who disagrees with the evidence a
  /// suspension was raised on can re-grant. `endReason` and `endDetail` carry
  /// what tripped it, because a suspension a human cannot evaluate is
  /// indistinguishable from an arbitrary one.
  suspended
}

/// Why a grant stopped authorizing anything. Written together with `endedAt`
/// on `TrustGrant` - a row with one set and not the other is a bug, not a
/// valid state.
enum TrustGrantEndReason {
  /// A human revoked it directly, through the UI or API.
  manual_revocation
  /// `expiresAt` passed with no renewal before it. VISION §8: "Renewal is one
  /// tap; silence revokes" - this is the default outcome of a grant that
  /// nobody acted on, not an edge case.
  expired
  /// Cumulative `spentUsd` reached `budgetCeilingUsd`.
  budget_exhausted
  /// Observed failure rate crossed `maxFailureRate`, measured only after
  /// `minActionsBeforeAutoRevoke` actions were authorized under the grant.
  failure_rate_exceeded
  /// A single authorized action's cost crossed `maxCostPerActionUsd`.
  cost_per_action_exceeded
  /// The action class this grant authorized was demoted off the promotion
  /// ladder (#99) - the evidence the grant rested on no longer holds.
  class_demoted
  /// Replaced by a renewal issued before this grant lapsed. See
  /// `renewedFromId` on the successor row for the chain.
  superseded_by_renewal
}

/// A scoped, expiring, budget-capped, self-revoking authorization to skip an
/// approval. VISION §8 / glossary: "Never 'trust the agent.'"
///
/// ## The four required attributes are required here, not just at the boundary
///
/// VISION §8 says every grant carries four attributes, "attached
/// automatically": scope, expiry, a budget ceiling, and auto-revoke
/// thresholds. #96's first acceptance criterion is that this holds at the
/// DATABASE level, not only in application code a caller could bypass. So
/// every column in each of the four groups below is NOT NULL with no default
/// that would let a caller skip supplying it:
///
///  - **Scope** - `actionClass`, `repositoryId`
///  - **Expiry** - `expiresAt`
///  - **Budget ceiling** - `budgetCeilingUsd`
///  - **Auto-revoke** - `maxFailureRate`, `maxCostPerActionUsd`,
///    `minActionsBeforeAutoRevoke`
///
/// ## Why there is no unique constraint on (actionClass, repositoryId, active)
///
/// Deliberately absent, not an oversight. Two overlapping active grants for
/// the same scope are legitimate: a renewal issued before the old grant lapses
/// is exactly this shape, chained through `renewedFromId`. A unique index here
/// would force renewal to be implemented as delete-then-create, which loses
/// the chain #115 needs to detect a grant widening across a sequence of
/// renewals - so it is left out on purpose.
model TrustGrant {
  id String @id @default(uuid()) @db.Uuid

  // --- Scope ----------------------------------------------------------------
  //
  // action class x repository. Never "trust the agent" - VISION §8.

  /// An `ActionClassId` from `apps/api/src/supervisor/action-classes.ts`,
  /// validated at the boundary rather than by a database enum. TEXT for the
  /// reason ADR-0010 and ADR-0011 both give: an enum addition is a MAJOR
  /// schema bump, and the class taxonomy a grant can name is expected to grow
  /// as the promotion ladder does - an ordinary event, not a breaking one.
  actionClass String @map("action_class")

  /// NOT NULL with no "all repositories" representation anywhere in this
  /// model - not a sentinel value, not a nullable column that would mean
  /// "every repository" if left unset. VISION §8: "Never 'trust the agent.'"
  /// A nullable `repositoryId` is exactly the global-grant shape that sentence
  /// forbids; making it unrepresentable here means no validator anywhere has
  /// to remember to reject one, because no code path can construct one in the
  /// first place. `onDelete: Cascade` - a grant scoped to a repository that no
  /// longer exists authorizes nothing and should not survive it.
  repositoryId String @map("repository_id") @db.Uuid

  // --- Expiry -----------------------------------------------------------------
  //
  // Days or session. Renewal is one tap; silence revokes - VISION §8.

  /// No default. Expiry is not a reminder attached to an otherwise-durable
  /// grant - it IS the default outcome. Renewal is an action a human takes
  /// (#115 builds the prompt); doing nothing lets the grant lapse. That is
  /// what makes "silence revokes" a mechanism rather than a sentence nobody
  /// enforces.
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  // --- Budget ceiling -----------------------------------------------------
  //
  // The grant dies at a cumulative spend - VISION §8.

  /// The cumulative spend at which this grant dies. NOT NULL, no default: a
  /// grant with no ceiling is not a narrower grant, it is a blank check.
  /// Same `Decimal(10, 4)` precision as `Run.costUsd` and
  /// `SupervisorInvocation.costUsd`.
  budgetCeilingUsd  Decimal @map("budget_ceiling_usd") @db.Decimal(10, 4)
  /// Running total spent under this grant. Starts at zero; compared against
  /// `budgetCeilingUsd` on every authorization check.
  spentUsd          Decimal @default(0) @map("spent_usd") @db.Decimal(10, 4)
  /// Count of actions authorized under this grant, whether or not they
  /// succeeded. The denominator for the failure rate `maxFailureRate` checks.
  actionsAuthorized Int     @default(0) @map("actions_authorized")

  // --- Auto-revoke ------------------------------------------------------------
  //
  // Failure rate or cost-per-PR crossing a threshold suspends the grant and
  // explains why - VISION §8.

  /// Threshold in [0.000, 1.000]. Crossing it (after the minimum sample size
  /// below) suspends the grant with `endReason = failure_rate_exceeded`.
  maxFailureRate             Decimal @map("max_failure_rate") @db.Decimal(4, 3)
  /// Threshold in USD. A single action costing more than this suspends the
  /// grant with `endReason = cost_per_action_exceeded`, independent of the
  /// failure-rate check.
  maxCostPerActionUsd        Decimal @map("max_cost_per_action_usd") @db.Decimal(10, 4)
  /// The minimum number of authorized actions before the failure-rate
  /// auto-revoke may fire at all. NOT NULL with a default, not NOT NULL with
  /// none, because 3 is a reasonable floor a caller should be able to accept
  /// rather than be forced to type out.
  ///
  /// Exists because a grant's first action failing is a 100% observed failure
  /// rate on a sample of one. Auto-revoking on one observation would make
  /// every grant die on its first unlucky action, which is the same
  /// sample-size argument #99 makes about PROMOTING a class on too little
  /// evidence, applied here to DEMOTING one.
  minActionsBeforeAutoRevoke Int     @default(3) @map("min_actions_before_auto_revoke")

  /// Count of authorized actions that failed. The numerator for the
  /// failure-rate check paired with `actionsAuthorized`.
  actionsFailed Int @default(0) @map("actions_failed")

  // --- Lifecycle ------------------------------------------------------------

  status TrustGrantStatus @default(active)

  endedAt   DateTime?            @map("ended_at") @db.Timestamptz
  endReason TrustGrantEndReason? @map("end_reason")
  /// Free-text explanation, required IN PRACTICE for anything automatic even
  /// though the column allows null. A grant that vanishes silently teaches
  /// the operator the system is unpredictable, which is precisely how
  /// blanket trust gets granted the next time around - the friction VISION
  /// §8 opens this section warning about. `endReason` alone is a category;
  /// this is the sentence a human reads on the daily digest.
  endDetail String?              @map("end_detail")

  /// Who revoked it, when a human did.
  ///
  /// Null for a grant that ended any other way, and that null is meaningful:
  /// an automatic suspension, an expiry, and a supersession all end a grant
  /// with nobody deciding, and a column that named an actor for those would
  /// be inventing one. `endReason` says WHICH of those happened; this says
  /// WHO, only when there is a who.
  ///
  /// SetNull rather than Restrict, unlike `grantedById`: a revocation is a
  /// safe act and the grant is already over, so the record surviving the
  /// account is enough. A grant that is still LIVE must keep naming its
  /// granter, which is why that edge restricts and this one does not.
  revokedById String? @map("revoked_by_id") @db.Uuid

  /// Free text from the granting human - why this scope, why this ceiling.
  note String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // --- Provenance -------------------------------------------------------------

  /// The human who gave this grant. `onDelete: Restrict` - a grant must
  /// always name the human who authorized it; deleting that user while a
  /// grant of theirs still exists would silently orphan the grant's
  /// authority into a name nobody owns, which is exactly the accountability
  /// gap VISION §5's provenance model exists to close.
  grantedById String @map("granted_by_id") @db.Uuid

  /// The proposal whose approval created this grant, if any - the "Always
  /// approve this class" tap VISION §8 describes attaching all four
  /// attributes at once. Null for a grant a human created directly with no
  /// proposal behind it. `onDelete: SetNull`: the grant outlives the proposal
  /// row losing its provenance pointer rather than being deleted with it.
  grantedFromProposalId String? @map("granted_from_proposal_id") @db.Uuid

  /// The grant this one renewed, if any. Self-relation, `onDelete: SetNull`,
  /// so #115's renewal chain stays walkable and a scope or ceiling that
  /// widened across a sequence of renewals is detectable after the fact
  /// rather than lost the moment the old grant expired.
  renewedFromId String? @map("renewed_from_id") @db.Uuid

  // Relations
  repository           Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  grantedBy            User                @relation("TrustGrantsGranted", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy            User?               @relation("TrustGrantsRevoked", fields: [revokedById], references: [id], onDelete: SetNull)
  grantedFromProposal  SupervisorProposal? @relation("TrustGrantsFromProposal", fields: [grantedFromProposalId], references: [id], onDelete: SetNull)
  renewedFrom          TrustGrant?         @relation("TrustGrantRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals             TrustGrant[]        @relation("TrustGrantRenewal")
  /// Approval requests this grant authorized (skipped the human) - #100's
  /// digest reads this to report what ran under trust.
  approvalRequests     ApprovalRequest[]   @relation("ApprovalRequestsUnderGrant")
  /// Approval requests where an operator tapped "Always approve this class"
  /// and this grant was minted from the decision. The other edge of the two
  /// distinct relationships an approval can have to a grant - see
  /// `ApprovalRequest.grantId` vs `ApprovalRequest.createdGrantId`.
  createdFromApprovals ApprovalRequest[]   @relation("ApprovalRequestsCreatingGrant")

  // THE authorization query: is there an active grant for this class in this
  // repository.
  @@index([actionClass, repositoryId, status])
  // The expiry sweep, and #115's "expiring soon" query.
  @@index([status, expiresAt])
  @@index([repositoryId])
  @@index([grantedById])
  // "What did this user revoke" — the query the column exists for.
  @@index([revokedById])
  @@map("trust_grants")
}

// =============================================================================
// Opifex Domain - Approval Requests
// =============================================================================

/// What happens to an approval nobody answers, resolved by ADR-0014's total
/// order over ADR-0011's existing reversibility classification and
/// `spendsMoney` - never a second axis of its own.
///
/// Recorded on the request itself, at raise time, rather than recomputed at
/// resolution - see `ApprovalRequest.timeoutPolicy` for why that matters.
enum ApprovalTimeoutPolicy {
  /// Silence means yes, logged. ADR-0014 rule 4: only `reversible` classes
  /// with no other rule matching land here - VISION §8's narrow reading, not
  /// the wider one ADR-0014 explicitly declined to make.
  auto_approve
  /// Silence means no. ADR-0014 rules 2 and 3: anything that spends money, or
  /// is merely `reversible-with-effort`, denies on timeout rather than
  /// auto-approving. Under this order every autonomy-eligible class with a
  /// real effect ends up here or in `park_and_escalate` - the trust grant,
  /// not the timeout, is what actually delivers autonomy (ADR-0014).
  deny
  /// Silence means nothing resolves. ADR-0014 rule 1, and ADR-0013's rule 0
  /// (a never-trustable effect) both land here in effect, though rule 0 is a
  /// refusal rather than a gate outcome. `irreversible` is never
  /// auto-approved under any grant or any timeout - VISION §8. See
  /// `ApprovalRequest.timeoutAt`, which is null for this policy and stays
  /// null for exactly this reason.
  park_and_escalate
}

/// Where an approval request stands, and - critically - WHO or WHAT decided
/// it. This is the enum the whole model exists to make precise.
///
/// `approved`/`denied` are a human's verdict; `auto_approved`/`auto_denied`
/// are what happened because nobody answered before `timeoutAt`. Collapsing
/// either pair into a single boolean would let #99's promotion ladder count
/// silence as agreement - the single most important reason these are four
/// values, not two: a class that is never proposed to a human and always
/// times out reversible would promote itself by being ignored, which is
/// exactly the self-dealing evidence problem VISION §7's "on evidence, never
/// in bulk" exists to prevent.
enum ApprovalStatus {
  /// Raised, still within its timeout window (or has none - see
  /// `park_and_escalate`), waiting on a human or the clock.
  pending
  /// A human said yes. Counts toward #99's approval-rate numerator.
  approved
  /// A human said no. Counts toward #99's approval-rate denominator, not its
  /// numerator - a timeout denial (`auto_denied`) counts toward neither, per
  /// the same argument mirrored.
  denied
  /// Nobody answered before `timeoutAt` and the resolved `timeoutPolicy` was
  /// `auto_approve`. NOT evidence a human would have agreed - see the enum
  /// doc comment. `decidedVia` is `timeout` for every row in this state.
  auto_approved
  /// Nobody answered before `timeoutAt` and the resolved `timeoutPolicy` was
  /// `deny`. NOT evidence a human would have disapproved, mirroring
  /// `auto_approved`'s argument exactly.
  auto_denied
  /// Raised under `park_and_escalate`, escalated, still waiting - and will
  /// wait indefinitely. VISION §8: irreversible actions are never
  /// auto-approved, so this status has no timer that resolves it. Only a
  /// human moves a row out of `parked`, into `approved` or `denied`. This is
  /// the "never auto-approve" guarantee expressed as a status with no exit
  /// but a person.
  parked
  /// The underlying condition changed and the question stopped being worth
  /// asking - the run finished, the work order was cancelled, the proposal
  /// it was raised for was superseded. Distinct from `denied`: nobody
  /// refused this, the world moved on before anyone had to.
  superseded
}

/// How a resolved `ApprovalRequest` actually got resolved. Null while
/// `status` is `pending` or `parked` - `parked` has no resolution yet by
/// construction, and pairs with `decidedAt`/`decidedById`/`decisionNote` the
/// same way `TrustGrantEndReason` pairs with `TrustGrant.endedAt`: a row with
/// one set and not the others is a bug, not a valid state.
enum ApprovalDecidedVia {
  /// A person clicked Approve or Deny. VISION §8's "one tap from a phone."
  human
  /// Nobody answered before `timeoutAt`; the resolved `timeoutPolicy` decided
  /// it. Pairs with `status` being `auto_approved` or `auto_denied`.
  timeout
  /// A `TrustGrant` already covered this action class and repository, so the
  /// request was authorized without ever becoming a human-facing interrupt.
  /// `grantId` names which one. VISION §8: "auto-approved actions still
  /// record what *would* have been asked" - this row IS that record, and
  /// #100's digest reads it.
  grant
}

/// One question raised for a human, or resolved without one: "may this
/// action proceed." VISION §8's whole approvals system is this row's
/// lifecycle - raised with enough context to decide "in one tap", resolved by
/// a human, a timeout, or a standing grant, and kept either way as the
/// auditable record of what was asked and what happened.
///
/// ## Why this table, and not a field on `SupervisorProposal`
///
/// A proposal is the supervisor's judgment call about what to do (VISION §7,
/// Phase 6 - advisory, off the execution path). An approval request is a gate
/// on whether an action may actually take effect (VISION §8, Phase 7). Not
/// every approval traces back to a proposal - `proposalId` is nullable
/// precisely because an action can be raised for approval with nobody having
/// proposed it first - and not every proposal that would be approved reaches
/// execution at all under the current promotion ladder. Folding the two
/// together would make "was this proposed" and "was this allowed to run" the
/// same question, which ADR-0013 already spent a decision keeping separate
/// for proposals versus effects; the same argument holds one level up.
///
/// ## `effects` is stored, not re-derived
///
/// `effects` holds the `AutonomyEffect[]` (ADR-0013) this action declared at
/// raise time, so an approval can be AUDITED against what the action would
/// actually have done, not against what it was labelled as. `effectsFor` is
/// the single source of truth for that mapping (ADR-0013); this column is the
/// record of what it produced for THIS request, frozen at the moment the gate
/// was consulted, so a later change to `effectsFor` cannot retroactively
/// change what a historical approval is understood to have authorized.
model ApprovalRequest {
  id String @id @default(uuid()) @db.Uuid

  /// An `ActionClassId` from `apps/api/src/supervisor/action-classes.ts`,
  /// validated at the boundary rather than by a database enum - the same
  /// reason `TrustGrant.actionClass` and `SupervisorProposal.actionClass`
  /// are TEXT (ADR-0010, ADR-0011): the class taxonomy is expected to grow as
  /// the promotion ladder does, an ordinary event, not a breaking one.
  actionClass String @map("action_class")

  repositoryId String @map("repository_id") @db.Uuid

  /// The proposal that suggested this action, if any. Nullable - VISION §8's
  /// gate applies to any action about to take effect, and not every one of
  /// those was suggested by the supervisor first; a human-initiated action or
  /// a deterministic dispatch decision can raise an approval with nothing in
  /// `SupervisorProposal` behind it. `onDelete: SetNull`: the approval record
  /// outlives the proposal row losing its provenance pointer, matching
  /// `TrustGrant.grantedFromProposalId`'s rationale exactly.
  proposalId String? @map("proposal_id") @db.Uuid

  /// What this approval is about: `run`, `work-order`, `issue`, or `factory`
  /// for something with no single subject - the same shape and the same
  /// rationale as `SupervisorProposal.targetKind`. Free strings at the column,
  /// a closed union at the boundary.
  targetKind String? @map("target_kind")
  /// The subject's stable identifier. NOT a foreign key, deliberately: the
  /// request must outlive the row it discusses - a work order that finished
  /// or an issue that closed does not erase the record of what was asked
  /// about it, matching `SupervisorProposal.targetRef`'s rationale exactly.
  targetRef  String? @map("target_ref")

  /// What is being asked, one line.
  summary String

  /// Why it was proposed, in enough detail that a reviewer judges the
  /// argument rather than the conclusion. VISION §8 requires "enough context
  /// to decide - what, why, blast radius, and what happens if ignored" - this
  /// is the "why".
  reasoning String

  /// What else is affected - the "blast radius" VISION §8 requires a reviewer
  /// be shown alongside the why.
  blastRadius String @map("blast_radius")

  /// The `AutonomyEffect[]` (ADR-0013) this action declared at raise time.
  /// Stored so an approval can be audited against what it would actually have
  /// done, not against what it was labelled. See the model doc comment.
  effects Json

  /// The action's estimated cost, if it has one. NULL MEANS UNKNOWN, NOT
  /// ZERO (VISION §6) - the same "unknown and zero are different" argument
  /// `Run.costUsd` and `TrustGrant.budgetCeilingUsd`'s neighbours make
  /// throughout this schema. A `spendsMoney` action whose cost could not be
  /// estimated is not a free action; it is an action the gate could not price
  /// and must not treat as costing nothing.
  estimatedCostUsd Decimal? @map("estimated_cost_usd") @db.Decimal(10, 4)

  /// The timeout disposition, resolved from the ADR-0014 total order against
  /// the registry AT RAISE TIME and recorded here - NOT recomputed at
  /// resolution time.
  ///
  /// This is load-bearing, not a caching optimization: this value is what the
  /// operator was told would happen if they ignored the request (the
  /// notification VISION §8 requires says "what happens if ignored").
  /// Recomputing it later - after a registry edit, a reversibility
  /// reclassification, or a `spendsMoney` flip - would mean the system acts
  /// on a policy other than the one it promised, silently. The notification
  /// and the eventual resolution must agree, and the only way to guarantee
  /// that is to freeze the decision the moment it was communicated.
  timeoutPolicy ApprovalTimeoutPolicy @map("timeout_policy")

  /// When this request resolves itself if nobody answers. NULL FOR
  /// `park_and_escalate` - that policy has no timer, ever.
  ///
  /// The null here IS the "never auto-approve" guarantee from VISION §8
  /// expressed in data, not merely in application logic: there is no sweeper
  /// query, no cron expression, and no timestamp anywhere that could cause a
  /// `parked` request to resolve itself. A bug that iterated "everything with
  /// a due timeout" would find no row for a parked request to accidentally
  /// include, because none was ever written.
  timeoutAt DateTime? @map("timeout_at") @db.Timestamptz

  status ApprovalStatus @default(pending)

  /// When it was decided - by a human, a timeout, or a grant. Null while
  /// `pending` or `parked`.
  decidedAt DateTime? @map("decided_at") @db.Timestamptz
  /// Who decided it, when a human did. Null for `timeout` and `grant`
  /// resolutions, and that null is meaningful the same way
  /// `TrustGrant.revokedById`'s is: naming an actor for a resolution nobody
  /// personally made would be inventing one. `onDelete: SetNull` - the
  /// approval record outlives the account that decided it.
  decidedById String? @map("decided_by_id") @db.Uuid
  /// HOW it was decided - see `ApprovalDecidedVia`. Null while unresolved,
  /// paired with `decidedAt`.
  decidedVia  ApprovalDecidedVia? @map("decided_via")
  /// Free text from the deciding human, or a system-generated note for a
  /// timeout or grant resolution. Optional: a fast verdict with no prose is
  /// still a verdict.
  decisionNote String? @map("decision_note")

  /// The grant that authorized this action, when one did - `decidedVia:
  /// grant`. `onDelete: SetNull`: the approval record outlives the grant row
  /// losing its attribution pointer.
  ///
  /// VISION §8: "auto-approved actions still record what *would* have been
  /// asked" - THIS ROW is that record for a grant-authorized action, and
  /// #100's digest reads it to report what ran under trust without
  /// interrupting anyone.
  grantId String? @map("grant_id") @db.Uuid

  /// The grant that was MINTED from this approval, when an operator tapped
  /// "Always approve this class" (VISION §8's third option, which "silently
  /// attaches all four" grant attributes). `onDelete: SetNull`: the approval
  /// record outlives the grant it created.
  ///
  /// Deliberately a SEPARATE column from `grantId`, not a reuse of it: one
  /// grant may have AUTHORIZED this request, and a DIFFERENT grant may have
  /// been BORN from the decision made on it - two distinct edges over the
  /// lifetime of a single row. Collapsing them into one column would make
  /// #100's digest unable to tell "this action ran under existing trust"
  /// apart from "this action is the reason new trust now exists", which are
  /// different facts a digest reader needs to distinguish.
  createdGrantId String? @map("created_grant_id") @db.Uuid

  /// The escalation raised for this request, set only when `timeoutPolicy` is
  /// `park_and_escalate`. `onDelete: SetNull`: the approval record outlives
  /// the escalation row losing its pointer.
  escalationId String? @map("escalation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  repository   Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  proposal     SupervisorProposal? @relation("ApprovalRequestsFromProposal", fields: [proposalId], references: [id], onDelete: SetNull)
  decidedBy    User?               @relation("ApprovalRequestsDecided", fields: [decidedById], references: [id], onDelete: SetNull)
  grant        TrustGrant?         @relation("ApprovalRequestsUnderGrant", fields: [grantId], references: [id], onDelete: SetNull)
  createdGrant TrustGrant?         @relation("ApprovalRequestsCreatingGrant", fields: [createdGrantId], references: [id], onDelete: SetNull)
  escalation   Escalation?         @relation("ApprovalRequestEscalation", fields: [escalationId], references: [id], onDelete: SetNull)

  // The sweeper's query: what is pending and due.
  @@index([status, timeoutAt])
  // #99's per-class measurement.
  @@index([actionClass, status])
  @@index([repositoryId, status])
  // The pending queue, oldest first.
  @@index([status, createdAt])
  // #100's per-grant attribution.
  @@index([grantId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// The promotion ladder (#99, epic #22, VISION §7 "Earned autonomy")
// ---------------------------------------------------------------------------

/// Which of VISION §7's rungs an action class currently stands on.
///
/// Three values, not four. VISION §7 lists "Observe, Measure, Promote, Demote",
/// but demotion is a TRANSITION, not a place to stand - a demoted class is one
/// that is measuring again, and giving it its own rung would mean a class could
/// be simultaneously "demoted" and accumulating the evidence that re-promotes
/// it. What was demoted, and how often, lives in `changeReason` and
/// `demotionCount` instead, where it can be read without corrupting the rung.
///
/// A Prisma enum here, unlike `actionClass`, which is TEXT: ADR-0010 makes an
/// enum addition a MAJOR schema bump, and adding an action class is an ordinary
/// event while adding a rung to VISION §7's ladder is not.
enum PromotionRung {
  /// The supervisor proposes and executes nothing, and no human has judged a
  /// single proposal of this class yet. Zero evidence, not bad evidence.
  observe
  /// Evidence exists and is accruing. This is where a class sits while it is
  /// short of the sample or the rate, and it is also where a demoted class
  /// lands - `observe` would claim the class had never been measured, which
  /// is the one thing a regression proves false.
  measure
  /// Cleared both thresholds. The class is ELIGIBLE for a trust grant; it does
  /// not have one. See `PromotionService` on why the ladder never mints.
  promoted
}

/// Why a class last changed rung.
///
/// A category, paired with the sentence in `changeDetail` and the numbers in
/// `evidenceJson`. #99 requires that "both promotion and demotion notify, and
/// both state their evidence" - these three columns are that requirement in
/// storage, so the evidence survives the notification nobody read.
enum PromotionChangeReason {
  /// Cleared the rate threshold with sufficient sample.
  promoted_on_evidence
  /// Recent evidence fell below the demotion rate. VISION §7 rung 4:
  /// "automatic on regression, not a judgment call."
  demoted_on_regression
  /// The class is `autonomyEligible: false` in the registry and must never
  /// stand on the promoted rung, whatever its record says.
  demoted_ineligible
  /// A human took autonomy back directly. Reserved for #101's operator
  /// surface; the ladder itself never writes it.
  demoted_manually
  /// Reserved for #101's explicit global pause. The ladder never writes this
  /// either, and that is the guarantee rather than an omission: #99 requires
  /// the ladder be pausable "without dismantling the grants", so a pause
  /// changes no rung and therefore records no rung change.
  paused_globally
}

/// Where one action class stands on the ladder, and on what evidence.
///
/// ONE ROW PER CLASS, enforced by the unique index rather than by convention.
/// Two rows for `re-dispatch` would mean two answers to "may this run
/// unattended", and the reader that picked the wrong one would be granting
/// autonomy nobody measured.
///
/// ## Why the evidence is frozen and not recomputed
///
/// `evidenceJson` holds the counts the decision was actually made from,
/// written at decision time and never refreshed. Recomputing it on read would
/// be cheaper and would always be self-consistent - and it would also describe
/// a DIFFERENT FACTORY from the one the decision was made in. #99 requires
/// promotion and demotion to "state their evidence"; evidence that changes
/// after the fact cannot be checked against the decision, which is the only
/// thing stating it was for. The same argument `ApprovalRequest.timeoutPolicy`
/// and `effects` make about freezing at raise time (ADR-0013).
model PromotionState {
  id String @id @default(uuid()) @db.Uuid

  /// An `ActionClassId` from `apps/api/src/supervisor/action-classes.ts`,
  /// validated at the boundary rather than by a database enum - ADR-0011, and
  /// the same choice `TrustGrant.actionClass` and `ApprovalRequest.actionClass`
  /// make, for the same reason.
  actionClass String @unique @map("action_class")

  rung PromotionRung @default(observe)

  /// When the rung last changed. NOT "when the ladder last ran": an hourly
  /// evaluation that concluded nothing must not move this, or the column stops
  /// answering "how long has this been promoted" and starts answering "is the
  /// cron alive", which is a question the scheduler already answers.
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz

  /// Null on a row that has never changed rung since it was created.
  changeReason PromotionChangeReason? @map("change_reason")
  /// The sentence a human reads, naming the numbers. `changeReason` alone is a
  /// category - the same split `TrustGrant.endReason`/`endDetail` makes.
  changeDetail String?                @map("change_detail")

  /// The `ClassEvidence` the decision was made from, frozen. See above.
  evidenceJson Json? @map("evidence_json")

  /// When this class was MOST RECENTLY promoted, and most recently demoted.
  /// Both retained after a demotion: "promoted for six weeks, then demoted
  /// yesterday" and "promoted and demoted within a day" are different facts
  /// about how well the measurement is working, and keeping only the live one
  /// would erase the second.
  promotedAt DateTime? @map("promoted_at") @db.Timestamptz
  demotedAt  DateTime? @map("demoted_at") @db.Timestamptz

  /// How many times this class has been demoted, ever.
  ///
  /// Here because promoting something for the fourth time is a different act
  /// from promoting it once, and a rung alone cannot tell the two apart. A
  /// class that oscillates is evidence about the THRESHOLDS, not about the
  /// class - and without this counter that evidence is only visible to whoever
  /// happened to read the notifications.
  demotionCount Int @default(0) @map("demotion_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// #101's read: "what is promoted right now". Small table, but the index is
  /// what makes the cockpit query a lookup rather than a scan that grows with
  /// the taxonomy.
  @@index([rung])
  @@map("promotion_states")
}
